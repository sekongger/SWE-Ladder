# Site-local paths for scripts/tools/render_config.py.
#
#   cp site.env.example site.env     # site.env is gitignored
#   $EDITOR site.env
#   ../../scripts/tools/render_config.py ladder_4b_openhands_leg1_loc.yaml -o /tmp/run.yaml
#
# Values may reference earlier keys with ${KEY}, so in practice only the first
# few lines need editing. Any key a config does not use is simply ignored; run
# `render_config.py <config> --print-placeholders` to see what one requires.

# The workspace holding the upstream checkouts and the big artifacts: DeepSWE_RL/rllm
# (grafted by integration/install.sh), R2E-Gym/, models/, data/. Usually this
# repository's parent directory, but nothing requires that.
WORKSPACE_ROOT=/path/to/workspace

# Conda env with verl + vllm + torch_npu (NPU) or torch (CUDA). See integration/README.md.
CONDA_ENV=swe-ladder

# rllm checkout that integration/install.sh grafted swe_ladder/ into. Configs use
# it to point at the staged prompt trees under rllm/opd/prompt_templates_*.
RLLM_ROOT=${WORKSPACE_ROOT}/DeepSWE_RL/rllm

# Parent of the verl parquet datasets. Expected subdirectories, by config:
#   staged_opd_joint_swerebench500_r2e200_swegym100_swesmith500_task_intersection/
#     -> smoke, ARPO, SDAR, whole-answer, external-teacher, base-student, process-graph
#   ..._task_intersection_enriched/
#     -> every openhands ladder leg and the stage-router / privilege ablations
#        ("enriched" = teacher_pi carries LOC and REPRO evidence, not just the gold
#         patch; see data/README.md)
#   r2e_gym_lite_first2000_sweagent_staged[_promptfix_20261004]/
#     -> the sweagent-scaffold runs
# Each holds patch_generation/{train,valid}_verl.parquet.
DATA_ROOT=${WORKSPACE_ROOT}/data/rl_data

# Policy weights.
BASE_MODEL_4B=${WORKSPACE_ROOT}/models/Qwen3-4B-Instruct-2507
BASE_MODEL_8B=${WORKSPACE_ROOT}/models/Qwen3-8B-yarn
# SFT checkpoint used as the in-process teacher by ablation_base_student_sft_teacher.yaml.
SFT_MODEL_4B=${WORKSPACE_ROOT}/models/SWE-Master-4B-SFT
# Separately served teacher for ablation_external_served_teacher.yaml. Its tokenizer
# must be byte-identical to the student's -- see docs/TRAINING.md.
TEACHER_MODEL=${WORKSPACE_ROOT}/models/Qwen3-Coder-30B-A3B-Instruct

# R2E-Gym source tree prepended to PYTHONPATH by the runs that need the
# generic-sandbox variant (no pip install; the import path decides the tools).
R2EGYM_SRC=${WORKSPACE_ROOT}/R2E-Gym/src

# Optional artifacts, each needed by exactly one config.
#   ablation_process_graph_privilege.yaml
PROCESS_GRAPH_JSONL=${DATA_ROOT}/process_graphs/staged_opd_task_intersection_pgraph.jsonl
#   ablation_router_learned_classifier.yaml -- a pickle you supply; the contract is one
#   method, predict(["<tool_name> <lowercased action text>"]) -> "loc" | "rep" | "patch"
#   (full stage names also accepted). Any failure falls back to the rule router, so a
#   missing file degrades silently rather than stopping the run.
STAGE_CLASSIFIER_PKL=${WORKSPACE_ROOT}/artifacts/stage_clf.pkl

# Checkpoint a resuming leg starts from. The per-config header says which one;
# override per launch instead of editing this file:
#   render_config.py ladder_4b_openhands_leg2_repro.yaml \
#       --set RESUME_CHECKPOINT=/.../train_output/<leg1-run>/global_step_30 -o /tmp/run.yaml
RESUME_CHECKPOINT=${WORKSPACE_ROOT}/train_output/CHANGE_ME/global_step_30

# CUDA toolkit root, used only by the 4x CUDA configs.
CUDA_ROOT=/usr/local/cuda-12.8
