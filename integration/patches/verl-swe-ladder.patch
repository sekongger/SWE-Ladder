+def _tensor_debug_summary(tensor: torch.Tensor) -> str:
+    if not torch.is_tensor(tensor):
+        return f"type={type(tensor).__name__}"
+    with torch.no_grad():
+        detached = tensor.detach()
+        flat = detached.reshape(-1)
+        numel = flat.numel()
+        first8_tensor = flat[:8].float().cpu()
+        first8 = [round(float(x), 6) for x in first8_tensor.tolist()]
+        probe_indices = []
+        for idx in (0, 1, 7, 1024, numel // 2, max(numel - 8, 0), max(numel - 2, 0), max(numel - 1, 0)):
+            if 0 <= idx < numel and idx not in probe_indices:
+                probe_indices.append(idx)
+        if probe_indices:
+            idx_tensor = torch.tensor(probe_indices, device=flat.device)
+            probe_values_tensor = flat.index_select(0, idx_tensor).float().cpu()
+            probe_values = [round(float(x), 6) for x in probe_values_tensor.tolist()]
+        else:
+            probe_values = []
+        row_probe = []
+        if detached.ndim >= 2 and detached.shape[0] > 1:
+            row_indices = [0]
+            if detached.shape[0] >= 4:
+                quarter = detached.shape[0] // 4
+                for row in (
+                    quarter - 1,
+                    quarter,
+                    2 * quarter - 1,
+                    2 * quarter,
+                    3 * quarter - 1,
+                    3 * quarter,
+                ):
+                    if 0 <= row < detached.shape[0]:
+                        row_indices.append(row)
+            row_indices.append(detached.shape[0] - 1)
+            unique_rows = []
+            for row in row_indices:
+                if row not in unique_rows:
