+def create_file_mmap(size: int, directory: str | None = None):
+    """Create a file-backed mmap tensor buffer.
+
+    POSIX shared memory is normally backed by /dev/shm, which is often tiny in
+    containers. File-backed mmap keeps the same zero-copy buffer interface while
+    using a configurable filesystem such as /tmp.
+    """
+
+    mmap_dir = directory or os.getenv("RLLM_WEIGHT_SYNC_SHM_DIR", "/tmp")
+    os.makedirs(mmap_dir, exist_ok=True)
+    fd, path = tempfile.mkstemp(prefix="verl_weights_", dir=mmap_dir)
+    try:
+        os.ftruncate(fd, size)
+        file_obj = os.fdopen(fd, "r+b", buffering=0)
+        fd = -1
+        mmap_obj = mmap.mmap(file_obj.fileno(), size)
+    except Exception:
+        if fd >= 0:
+            os.close(fd)
+        try:
+            os.unlink(path)
+        except FileNotFoundError:
+            pass
+        raise
+    return mmap_obj, file_obj, path
+
+
+def rebuild_file_mmap(path: str, size: int, dtype=torch.uint8):
+    """Rebuild tensor from a file-backed mmap."""
+
+    file_obj = open(path, "r+b", buffering=0)
+    mmap_obj = mmap.mmap(file_obj.fileno(), size)
+    tensor = torch.frombuffer(mmap_obj, dtype=dtype)
+    return tensor, mmap_obj, file_obj
+
