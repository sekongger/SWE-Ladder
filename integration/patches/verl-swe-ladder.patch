+def _install_torch_npu_unpickle_stubs():
+    """Install minimal torch_npu symbols needed to load NPU-saved checkpoints.
+
+    This is intentionally not a torch_npu replacement. It only supports the
+    pickle globals used by torch.load for tensor reconstruction, then maps the
+    NPU tensor payload to a normal CPU tensor because all merger loads use
+    map_location="cpu".
+    """
+    if "torch_npu.utils.storage" in sys.modules and "torch_npu.npu._format" in sys.modules:
+        return
+    # Skip stub installation only when torch_npu is genuinely IMPORTABLE on this host.
+    # On an Ascend box torch_npu can be *installed* (find_spec succeeds) yet fail to import
+    # for a CPU-only merge -- e.g. `libhccl.so: cannot open shared object file` because the
+    # CANN env (set_env.sh) was not sourced in the merge shell. The old `find_spec is not
+    # None -> return` guard skipped the stubs in exactly that case, so torch.load then
+    # imported the real (broken) torch_npu during unpickling and died with
+    # `RuntimeError: Please register PrivateUse1HooksInterface ...`. Since the merge always
+    # loads with map_location="cpu", we do not need a functional torch_npu -- the stubs below
+    # rebuild NPU-saved tensors straight onto CPU.
+    try:
+        import torch_npu  # noqa: F401
+
+        return
+    except Exception:
+        # torch_npu absent or non-functional -> drop any partial entries and install stubs.
+        for _name in list(sys.modules):
+            if _name == "torch_npu" or _name.startswith("torch_npu."):
+                del sys.modules[_name]
+
+    torch_npu_module = sys.modules.setdefault("torch_npu", types.ModuleType("torch_npu"))
+    npu_module = sys.modules.setdefault("torch_npu.npu", types.ModuleType("torch_npu.npu"))
+    format_module = sys.modules.setdefault("torch_npu.npu._format", types.ModuleType("torch_npu.npu._format"))
+    utils_module = sys.modules.setdefault("torch_npu.utils", types.ModuleType("torch_npu.utils"))
+    storage_module = sys.modules.setdefault("torch_npu.utils.storage", types.ModuleType("torch_npu.utils.storage"))
+    for module_name, module in (
+        ("torch_npu", torch_npu_module),
+        ("torch_npu.npu", npu_module),
+        ("torch_npu.npu._format", format_module),
+        ("torch_npu.utils", utils_module),
+        ("torch_npu.utils.storage", storage_module),
+    ):
+        module.__spec__ = importlib.machinery.ModuleSpec(module_name, loader=None)
+
+    class Format:
+        def __init__(self, value=0):
+            self.value = value
+
+    Format.__module__ = "torch_npu.npu._format"
+
+    def _rebuild_npu_tensor(storage, storage_offset, size, stride, requires_grad, backward_hooks, npu_format=None):
+        return torch._utils._rebuild_tensor_v2(storage, storage_offset, size, stride, requires_grad, backward_hooks)
+
+    format_module.Format = Format
+    storage_module._rebuild_npu_tensor = _rebuild_npu_tensor
+    npu_module._format = format_module
+    utils_module.storage = storage_module
+    torch_npu_module.npu = npu_module
+    torch_npu_module.utils = utils_module
+
+
+def _ensure_npu_checkpoint_device_is_loadable():
+    """Allow GPU-only PyTorch to unpickle checkpoints saved with NPU DTensor metadata.
+
+    FSDP checkpoints saved on Ascend can contain DTensor DeviceMesh objects whose
+    device type is serialized as "npu". ``map_location="cpu"`` handles tensor
+    storages, but PyTorch must still know the device type while unpickling the
+    DeviceMesh metadata. On GPU hosts without torch_npu, registering PrivateUse1
+    under the "npu" name is enough for deserialization; tensors are still loaded
+    onto CPU by the caller's map_location.
+    """
+    _install_torch_npu_unpickle_stubs()
+    try:
+        torch.device("npu")
+        return
+    except (RuntimeError, TypeError):
+        pass
+
+    try:
+        torch.utils.rename_privateuse1_backend("npu")
+        if hasattr(torch.utils, "generate_methods_for_privateuse1_backend"):
+            torch.utils.generate_methods_for_privateuse1_backend()
+    except RuntimeError as exc:
+        try:
+            torch.device("npu")
+            return
+        except (RuntimeError, TypeError):
+            raise RuntimeError(
+                "Failed to register 'npu' as a PyTorch PrivateUse1 backend for "
+                "loading NPU-saved FSDP checkpoints on this host."
+            ) from exc
+
