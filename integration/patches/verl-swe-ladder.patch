+def safe_reshard_fsdp_module(module, role: str):
+    """Best-effort FSDP reshard after eval/log-prob forwards.
+
+    FSDP v1's private ``_handle.reshard(True)`` can fail when the current
+    FlatParameter state does not own ``_local_shard``. In that state there is
+    no valid local shard to restore, so skip the private call instead of
+    crashing the worker during actor update.
+    """
+
+    version = fsdp_version(module)
+    if version == 1:
+        handle = getattr(module, "_handle", None)
+        if handle is None:
+            logger.debug("Skip FSDP v1 reshard for %s: module has no _handle", role)
+            return
+        flat_param = getattr(handle, "flat_param", None)
+        if flat_param is not None and not hasattr(flat_param, "_local_shard"):
+            logger.debug("Skip FSDP v1 reshard for %s: flat_param has no _local_shard", role)
+            return
+        try:
+            handle.reshard(True)
+        except AttributeError as exc:
+            if "_local_shard" in str(exc):
+                logger.debug("Skip FSDP v1 reshard for %s: %s", role, exc)
+                return
+            raise
+    elif version == 2 and hasattr(module, "reshard"):
+        module.reshard()
+
