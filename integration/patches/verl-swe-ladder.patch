+    @GPUMemoryLogger(role="dp actor", logger=logger)
+    def compute_log_prob_with_topk(self, data: DataProto, topk_k: int) -> dict[str, torch.Tensor]:
+        """Compute teacher/ref top-k token ids and log-probs for OPSD.
+
+        OPSD uses a teacher-only prompt that can differ from the student prompt.
+        The tensors are stored under ``opsd_teacher_*`` keys so the actor update
+        can still use the student-visible ``input_ids`` path.
+        """
+
+        if self.use_fused_kernels:
+            raise NotImplementedError(
+                "OPSD ref-policy teacher top-k currently requires use_fused_kernels=False"
+            )
+        if self.use_ulysses_sp and not self.use_remove_padding:
+            raise NotImplementedError(
+                "OPSD ref-policy teacher top-k supports Ulysses SP only with use_remove_padding=True"
+            )
+
+        self.actor_module.eval()
+        micro_batch_size = data.meta_info["micro_batch_size"]
+        temperature = data.meta_info["temperature"]
+        use_dynamic_bsz = data.meta_info["use_dynamic_bsz"]
+        if use_dynamic_bsz:
+            raise NotImplementedError("OPSD ref-policy teacher top-k does not support dynamic batch sizing yet")
+
+        select_keys = [
+            "responses",
+            "opsd_teacher_input_ids",
+            "opsd_teacher_attention_mask",
+            "opsd_teacher_position_ids",
+        ]
+        if "opsd_loss_mask" in data.batch.keys():
+            select_keys.append("opsd_loss_mask")
+        micro_batches = data.select(batch_keys=select_keys).split(micro_batch_size)
+
+        topk_token_ids_lst = []
+        topk_log_probs_lst = []
+        for micro_batch in micro_batches:
+            micro_batch = micro_batch.to(get_device_id())
+            model_inputs = {**micro_batch.batch, **micro_batch.non_tensor_batch}
+            with torch.no_grad():
+                topk_token_ids, topk_log_probs = self._forward_micro_batch_teacher_topk(
+                    model_inputs,
+                    temperature=temperature,
+                    topk_k=topk_k,
+                )
+            topk_token_ids_lst.append(topk_token_ids)
+            topk_log_probs_lst.append(topk_log_probs)
+
+        return {
+            "teacher_topk_token_ids": torch.concat(topk_token_ids_lst, dim=0),
+            "teacher_topk_log_probs": torch.concat(topk_log_probs_lst, dim=0),
+        }
+
+    def _forward_micro_batch_teacher_topk(
+        self,
+        micro_batch: dict[str, torch.Tensor],
+        *,
+        temperature: float,
+        topk_k: int,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        original_response_length = micro_batch["responses"].size(-1)
+        loss_mask = micro_batch.get("opsd_loss_mask")
+        active_response_length = self._active_response_prefix_len(loss_mask)
+        if active_response_length == 0:
+            token_ids = torch.zeros(
+                micro_batch["responses"].shape[0],
+                original_response_length,
+                topk_k,
+                dtype=micro_batch["responses"].dtype,
+                device=micro_batch["responses"].device,
+            )
+            log_probs = torch.full(
+                (micro_batch["responses"].shape[0], original_response_length, topk_k),
+                float("-inf"),
+                dtype=torch.float32,
+                device=micro_batch["responses"].device,
+            )
+            return token_ids, log_probs
+        if active_response_length is not None and active_response_length < original_response_length:
+            prompt_length = micro_batch["opsd_teacher_input_ids"].shape[-1] - original_response_length
+            seq_len = prompt_length + active_response_length
+            micro_batch = dict(micro_batch)
+            for key in (
+                "opsd_teacher_input_ids",
+                "opsd_teacher_attention_mask",
+                "opsd_teacher_position_ids",
+            ):
+                micro_batch[key] = self._slice_sequence_tensor(micro_batch[key], seq_len)
+            micro_batch["responses"] = micro_batch["responses"][:, :active_response_length]
+
+        response_length = micro_batch["responses"].size(-1)
+        with torch.autocast(device_type=self.device_name, dtype=self.param_dtype):
+            input_ids = micro_batch["opsd_teacher_input_ids"]
+            batch_size, seqlen = input_ids.shape
+            attention_mask = micro_batch["opsd_teacher_attention_mask"]
+            position_ids = micro_batch["opsd_teacher_position_ids"]
+            if position_ids.dim() == 3:
+                position_ids = position_ids.transpose(0, 1)
+
+            if self.use_remove_padding:
+                input_ids_rmpad, indices, _, *_ = unpad_input(input_ids.unsqueeze(-1), attention_mask)
+                input_ids_rmpad = input_ids_rmpad.transpose(0, 1)
+                if position_ids.dim() == 3:
+                    position_ids_rmpad = (
+                        index_first_axis(rearrange(position_ids, "c b s ... -> (b s) c ..."), indices)
+                        .transpose(0, 1)
+                        .unsqueeze(1)
+                    )
+                else:
+                    position_ids_rmpad = index_first_axis(
+                        rearrange(position_ids.unsqueeze(-1), "b s ... -> (b s) ..."), indices
+                    ).transpose(0, 1)
+
+                is_mask_all_zero = attention_mask.sum() == 0
+                if is_mask_all_zero:
+                    input_ids_rmpad = torch.zeros(
+                        (1, self.ulysses_sequence_parallel_size),
+                        device=input_ids.device,
+                        dtype=input_ids.dtype,
+                    )
+                    if position_ids.dim() == 3:
+                        position_ids_rmpad = torch.zeros(
+                            (position_ids.shape[0], 1, self.ulysses_sequence_parallel_size),
+                            device=position_ids.device,
+                            dtype=position_ids.dtype,
+                        )
+                    else:
+                        position_ids_rmpad = torch.zeros(
+                            (1, self.ulysses_sequence_parallel_size),
+                            device=position_ids.device,
+                            dtype=position_ids.dtype,
+                        )
+
+                if self.use_ulysses_sp:
+                    is_vlm_model = hasattr(
+                        getattr(self.actor_module, "module", self.actor_module).config, "vision_config"
+                    )
+                    if is_vlm_model:
+                        input_ids_rmpad, position_ids_rmpad, pad_size = ulysses_pad(
+                            input_ids_rmpad,
+                            position_ids_rmpad=position_ids_rmpad,
+                            sp_size=self.ulysses_sequence_parallel_size,
+                        )
+                    else:
+                        input_ids_rmpad, position_ids_rmpad, pad_size = ulysses_pad_and_slice_inputs(
+                            input_ids_rmpad,
+                            position_ids_rmpad=position_ids_rmpad,
+                            sp_size=self.ulysses_sequence_parallel_size,
+                        )
+
+                output = self.actor_module(
+                    input_ids=input_ids_rmpad,
+                    attention_mask=None,
+                    position_ids=position_ids_rmpad,
+                    use_cache=False,
+                )
+                logits_rmpad = output.logits.squeeze(0)
+                logits_rmpad.div_(temperature)
+                topk_log_probs, topk_token_ids = self._topk_log_probs_from_logits(logits_rmpad, topk_k=topk_k)
+
+                if self.use_ulysses_sp:
+                    topk_log_probs = gather_outputs_and_unpad(
+                        topk_log_probs,
+                        gather_dim=0,
+                        unpad_dim=0,
+                        padding_size=pad_size,
+                    )
+                    topk_token_ids = gather_outputs_and_unpad(
+                        topk_token_ids,
+                        gather_dim=0,
+                        unpad_dim=0,
+                        padding_size=pad_size,
+                        grad_scaler=False,
+                    )
+                if is_mask_all_zero:
+                    topk_log_probs = topk_log_probs[:0]
+                    topk_token_ids = topk_token_ids[:0]
+
+                full_topk_log_probs = pad_input(
+                    hidden_states=topk_log_probs,
+                    indices=indices,
+                    batch=batch_size,
+                    seqlen=seqlen,
+                )
+                full_topk_token_ids = pad_input(
+                    hidden_states=topk_token_ids,
+                    indices=indices,
+                    batch=batch_size,
+                    seqlen=seqlen,
+                )
+                token_ids = full_topk_token_ids[:, -response_length - 1 : -1, :]
+                log_probs = full_topk_log_probs[:, -response_length - 1 : -1, :]
+                return (
+                    self._pad_topk_response(
+                        token_ids,
+                        response_length=original_response_length,
+                        fill_value=0,
+                    ),
+                    self._pad_topk_response(
+                        log_probs,
+                        response_length=original_response_length,
+                        fill_value=float("-inf"),
+                    ),
+                )
+
+            output = self.actor_module(
+                input_ids=input_ids,
+                attention_mask=attention_mask,
+                position_ids=position_ids,
+                use_cache=False,
+            )
+            logits = output.logits
+            logits.div_(temperature)
+            logits = logits[:, -response_length - 1 : -1]
+            topk_log_probs, topk_token_ids = self._topk_log_probs_from_logits(logits, topk_k=topk_k)
+            return (
+                self._pad_topk_response(
+                    topk_token_ids,
+                    response_length=original_response_length,
+                    fill_value=0,
+                ),
+                self._pad_topk_response(
+                    topk_log_probs,
+                    response_length=original_response_length,
+                    fill_value=float("-inf"),
+                ),
+            )
