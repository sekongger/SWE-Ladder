+    def _build_rlsd_actor_teacher_advantages(
+        self,
+        *,
+        model_inputs: dict[str, torch.Tensor],
+        advantages: torch.Tensor,
+        student_prior_log_prob: torch.Tensor,
+        response_mask: torch.Tensor,
+        temperature: float,
+        rlsd_config: dict,
+    ) -> tuple[torch.Tensor, dict[str, float]]:
+        """Use the local actor as a detached privileged RLSD teacher."""
+
+        lambda_rlsd = float(rlsd_config.get("lambda_rlsd", 1.0))
+        active_advantage = advantages.detach() * response_mask.to(dtype=advantages.dtype)
+        if lambda_rlsd == 0.0 or not bool((active_advantage != 0).any().item()):
+            return advantages, {
+                "rlsd_lambda": lambda_rlsd,
+                "rlsd_teacher_scoring_skipped": 1.0,
+                "rlsd_teacher_forward_seconds": 0.0,
+                "use_rlsd": 1.0,
+                "use_opsd_kl": 0.0,
+                "opsd_kl_loss_not_added": 1.0,
+            }
+
+        required = {
+            "responses",
+            "opsd_teacher_input_ids",
+            "opsd_teacher_attention_mask",
+            "opsd_teacher_position_ids",
+        }
+        missing = required - set(model_inputs)
+        if missing:
+            raise ValueError(f"RLSD actor teacher is missing privileged input tensors: {sorted(missing)}")
+        responses = model_inputs["responses"]
+        response_length = responses.shape[-1]
+        teacher_input_ids = model_inputs["opsd_teacher_input_ids"]
+        if not torch.equal(teacher_input_ids[:, -response_length:], responses):
+            raise ValueError("RLSD actor teacher response suffix is not aligned with sampled response ids")
+
+        teacher_inputs = dict(model_inputs)
+        teacher_inputs["input_ids"] = teacher_input_ids
+        teacher_inputs["attention_mask"] = model_inputs["opsd_teacher_attention_mask"]
+        teacher_inputs["position_ids"] = model_inputs["opsd_teacher_position_ids"]
+
+        # Score PI-conditioned tokens before policy forward so its no-grad
+        # activations cannot overlap with policy backward activations.
+        actor_was_training = self.actor_module.training
+        teacher_forward_start = time.perf_counter()
+        try:
+            self.actor_module.eval()
+            with torch.no_grad():
+                teacher_sampled_log_prob = self._forward_micro_batch(
+                    teacher_inputs,
+                    temperature=temperature,
+                    calculate_entropy=False,
+                )["log_probs"].detach()
+        finally:
+            self.actor_module.train(actor_was_training)
+        teacher_forward_seconds = time.perf_counter() - teacher_forward_start
+
+        result = compute_rlsd_token_advantage(
+            advantages,
+            teacher_sampled_log_prob,
+            student_prior_log_prob,
+            response_mask.to(dtype=advantages.dtype),
+            lambda_rlsd=lambda_rlsd,
+            weight_clip_eps=float(rlsd_config.get("weight_clip_eps", 0.2)),
+            delta_clip=float(rlsd_config.get("delta_clip", 5.0)),
+            return_stats=bool(rlsd_config.get("log_stats", True)),
+        )
+        if bool(rlsd_config.get("log_stats", True)):
+            token_advantages, metrics = result
+        else:
+            token_advantages, metrics = result, {}
+        metrics.update(
+            {
+                "rlsd_lambda": lambda_rlsd,
+                "rlsd_teacher_scoring_skipped": 0.0,
+                "rlsd_teacher_forward_seconds": teacher_forward_seconds,
+                "use_rlsd": 1.0,
+                "use_opsd_kl": 0.0,
+                "opsd_kl_loss_not_added": 1.0,
+            }
+        )
+        return token_advantages.to(dtype=advantages.dtype), metrics
