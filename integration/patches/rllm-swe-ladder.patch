+    explicit = os.environ.get("RAY_TMPDIR", "").strip()
+    if explicit:
+        return explicit
+    user = os.environ.get("USER") or f"uid-{os.getuid()}"
+    return f"/tmp/ray-{user}"
+
+
+def _build_ray_init_kwargs():
+    include_dashboard = os.environ.get("RLLM_RAY_INCLUDE_DASHBOARD", "0") == "1"
+    temp_dir = _default_ray_temp_dir()
+    Path(temp_dir).mkdir(parents=True, exist_ok=True)
+    os.environ["RAY_TMPDIR"] = temp_dir
+    return {
+        "runtime_env": _build_runtime_env(),
+        "include_dashboard": include_dashboard,
+        "_temp_dir": temp_dir,
+    }
+
+
+def _select_config(config, key: str, default=None):
+    value = OmegaConf.select(config, key, default=default)
+    return default if value == "???" else value
+
+
+def _to_plain_dict(value):
+    if value is None:
+        return {}
+    if OmegaConf.is_config(value):
+        return OmegaConf.to_container(value, resolve=True)
+    return dict(value)
+
+
+def _callable_is_async(fn) -> bool:
+    while isinstance(fn, partial):
+        fn = fn.func
+    return inspect.iscoroutinefunction(fn)
+
+
+def _env_flag(name: str, default: bool = False) -> bool:
+    value = os.environ.get(name)
+    if value is None:
+        return default
+    return value.strip().lower() in {"1", "true", "yes", "on"}
+
+
+def _merge_verl_ppo_defaults(config):
+    """Fill missing keys expected by newer verl before applying rLLM legacy shims."""
+    if not _VERL_GENERATED_PPO_CONFIG.exists():
+        return config
+    verl_defaults = OmegaConf.load(str(_VERL_GENERATED_PPO_CONFIG))
+    return OmegaConf.merge(verl_defaults, config)
+
+
+def _expose_output_dirs_in_hydra_run(config):
+    hydra_run_dir = Path.cwd().resolve()
+    links = {
+        "rollout_data": _select_config(config, "trainer.rollout_data_dir"),
+        "train_output": _select_config(config, "trainer.default_local_dir"),
+    }
+
+    for name, target in links.items():
+        if not target:
+            continue
+        target_path = Path(str(target)).expanduser().resolve()
+        target_path.mkdir(parents=True, exist_ok=True)
+
+        pointer_file = hydra_run_dir / f"{name}_path.txt"
+        pointer_file.write_text(str(target_path) + "\n")
+
+        link_path = hydra_run_dir / name
+        try:
+            if link_path.is_symlink() or link_path.is_file():
+                link_path.unlink()
+            elif link_path.exists():
+                continue
+            link_path.symlink_to(target_path, target_is_directory=True)
+        except OSError:
+            # The absolute path file above is the fallback when symlink creation is unavailable.
+            pass
+
+
+def _stash_rollout_legacy_field(rollout_config, key: str, value):
+    custom = _to_plain_dict(rollout_config.get("custom", {}))
+    legacy = dict(custom.get("rllm_legacy", {}))
+    legacy[key] = value
+    custom["rllm_legacy"] = legacy
+    rollout_config.custom = custom
+
+
+def _migrate_legacy_checkpoint_config(checkpoint_config):
+    if checkpoint_config is None or "contents" not in checkpoint_config:
+        return
+    legacy_contents = list(checkpoint_config["contents"])
+    if "save_contents" not in checkpoint_config:
+        checkpoint_config.save_contents = legacy_contents
+    if "load_contents" not in checkpoint_config:
+        checkpoint_config.load_contents = list(legacy_contents)
+    del checkpoint_config["contents"]
+
+
+def _normalize_legacy_verl_schema(config):
+    """Migrate legacy rLLM/verl keys that newer structured configs reject."""
+    with open_dict(config):
+        if _select_config(config, "algorithm.adv_estimator", None) == "loop":
+            # Legacy rLLM agent scripts used "loop" as a custom alias.
+            # With modern verl, the matching critic-based estimator is GAE.
+            config.algorithm.adv_estimator = "gae"
+            config.critic.enable = True
+
+        _migrate_legacy_checkpoint_config(config.actor_rollout_ref.actor.checkpoint)
+        _migrate_legacy_checkpoint_config(config.critic.checkpoint)
+
+        actor_config = config.actor_rollout_ref.actor
+        if "ppo_num_mini_batches" in actor_config:
+            del actor_config["ppo_num_mini_batches"]
+        if "use_dynamic_mini_batch" in actor_config:
+            actor_config.use_dynamic_bsz = actor_config.get("use_dynamic_bsz", False) or bool(
+                actor_config["use_dynamic_mini_batch"]
+            )
+            del actor_config["use_dynamic_mini_batch"]
+        if "grad_norm_threshold" in actor_config:
+            del actor_config["grad_norm_threshold"]
+
+        actor_model_path = config.actor_rollout_ref.model.get("path", None)
+        critic_model_path = config.critic.model.get("path", None)
+        if actor_model_path is not None and critic_model_path in (None, _LEGACY_DEFAULT_MODEL_PATH):
+            config.critic.model.path = actor_model_path
+
+        actor_micro_batch_size = config.actor_rollout_ref.actor.get("ppo_micro_batch_size_per_gpu", None)
+        critic_micro_batch_size = config.critic.get("ppo_micro_batch_size_per_gpu", None)
+        if actor_micro_batch_size is not None and critic_micro_batch_size is None:
+            config.critic.ppo_micro_batch_size_per_gpu = actor_micro_batch_size
+
+        critic_forward_micro_batch_size = config.critic.get("forward_micro_batch_size_per_gpu", None)
+        if config.critic.get("ppo_micro_batch_size_per_gpu", None) is not None and critic_forward_micro_batch_size is None:
+            config.critic.forward_micro_batch_size_per_gpu = config.critic.ppo_micro_batch_size_per_gpu
+
+        rollout_config = config.actor_rollout_ref.rollout
+        if rollout_config.get("load_format", None) == "dummy_dtensor":
+            rollout_config.load_format = "dummy"
+        if rollout_config.get("mode") == "sync":
+            _stash_rollout_legacy_field(rollout_config, "original_mode", "sync")
+            rollout_config.mode = "async"
+
+        if "chat_template" in rollout_config:
+            chat_template = rollout_config["chat_template"]
+            if chat_template is not None and config.actor_rollout_ref.model.get("custom_chat_template", None) is None:
+                config.actor_rollout_ref.model.custom_chat_template = chat_template
+            _stash_rollout_legacy_field(rollout_config, "chat_template", chat_template)
+            del rollout_config["chat_template"]
+
+        for key in ("chat_scheduler", "disable_logging", "use_fire_sampling"):
+            if key in rollout_config:
+                _stash_rollout_legacy_field(rollout_config, key, rollout_config[key])
+                del rollout_config[key]
+
+        if "multi_turn" in rollout_config and "max_turns" in rollout_config.multi_turn:
+            legacy_max_turns = rollout_config.multi_turn["max_turns"]
+            if (
+                legacy_max_turns is not None
+                and rollout_config.multi_turn.get("max_assistant_turns", None) is None
+            ):
+                rollout_config.multi_turn.max_assistant_turns = legacy_max_turns
+            del rollout_config.multi_turn["max_turns"]
+
+    return config
+
+
+def _normalize_reward_config(config):
+    rollout_name = _select_config(config, "actor_rollout_ref.rollout.name", "vllm")
+    reward_defaults = OmegaConf.create(
+        {
+            "reward": {
+                "num_workers": 8,
+                "custom_reward_function": {
+                    "path": None,
+                    "name": "compute_score",
+                },
+                "reward_manager": {
+                    "source": "register",
+                    "name": "naive",
+                    "module": {
+                        "path": None,
+                        "name": "custom_reward_manager",
+                    },
+                },
+                "reward_model": {
+                    "enable": False,
+                    "enable_resource_pool": False,
+                    "n_gpus_per_node": _select_config(config, "trainer.n_gpus_per_node", 1),
+                    "nnodes": 0,
+                    "model_path": None,
+                    "rollout": {
+                        "name": rollout_name,
+                        "dtype": _select_config(config, "actor_rollout_ref.rollout.dtype", "bfloat16"),
+                        "gpu_memory_utilization": _select_config(
+                            config, "actor_rollout_ref.rollout.gpu_memory_utilization", 0.5
+                        ),
+                        "enforce_eager": _select_config(config, "actor_rollout_ref.rollout.enforce_eager", True),
