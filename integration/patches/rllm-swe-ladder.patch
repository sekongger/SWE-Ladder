index 0000000..b48d1f4
--- /dev/null
+++ b/rllm/trainer/verl/layout.py
@@ -0,0 +1,38 @@
+from __future__ import annotations
+
+from omegaconf import OmegaConf
+
+
+def _select_config(config, key: str, default=None):
+    value = OmegaConf.select(config, key, default=default)
+    return default if value == "???" else value
+
+
+def select_trainer_layout(config) -> dict:
+    """Select colocated or split rollout/actor resource pools.
+
+    In pipeline mode, rollout workers are allocated first so the first visible
+    devices can be reserved for vLLM rollout, while actor/ref workers use the
+    remaining training devices.
+    """
+    nnodes = int(_select_config(config, "trainer.nnodes", 1) or 1)
+    total_gpus = int(_select_config(config, "trainer.n_gpus_per_node", 1) or 1)
+    training_gpus = int(_select_config(config, "trainer.n_training_gpus_per_node", total_gpus) or total_gpus)
+    hybrid_engine = bool(_select_config(config, "actor_rollout_ref.hybrid_engine", True))
+
+    if not hybrid_engine and 0 < training_gpus < total_gpus:
+        rollout_gpus = total_gpus - training_gpus
+        return {
+            "mode": "pipeline",
+            "resource_pool_spec": {
+                "rollout_pool": [rollout_gpus] * nnodes,
+                "actor_pool": [training_gpus] * nnodes,
+            },
+        }
+
+    return {
+        "mode": "colocated",
+        "resource_pool_spec": {
+            "global_pool": [total_gpus] * nnodes,
+        },
+    }
