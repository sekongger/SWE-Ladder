+    @staticmethod
+    def _trajectory_token_cost(trajectory: dict) -> int:
+        """Best-effort cost used only for length bucketing completed trajectories."""
+
+        metrics = trajectory.get("metrics") or {}
+        for key in (
+            "opsd_actor_context_tokens_for_training",
+            "opsd_response_tokens_for_training",
+            "total_response_tokens_num",
+            "response_length",
+        ):
+            value = metrics.get(key)
+            if value is None:
+                continue
+            try:
+                return int(value)
+            except (TypeError, ValueError):
+                continue
+
+        for key in ("response_tokens", "responses", "tokens"):
+            tokens = trajectory.get(key)
+            if tokens is None:
+                continue
+            try:
+                return int(tokens.numel())
+            except AttributeError:
+                try:
+                    return len(tokens)
+                except TypeError:
+                    continue
+        return 0
