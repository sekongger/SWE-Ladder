+    def _configure_pipeline_checkpoint_engine(self, device_name: str):
+        checkpoint_engine_cfg = self.config.actor_rollout_ref.rollout.checkpoint_engine
+        backend = checkpoint_engine_cfg.get("backend", "naive")
+
+        if backend == "naive" and device_name not in {"cuda", "npu"}:
+            raise RuntimeError(
+                "Pipeline split actor/rollout training requires a non-naive checkpoint engine on accelerators."
+            )
