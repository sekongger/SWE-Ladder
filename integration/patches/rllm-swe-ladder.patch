+    def _exploration_tool_reward(self, non_finish_tool_calls: int) -> float:
+        agent_cfg = self._cfg_get(self.config, "agent", {})
+        coef = float(self._cfg_get(agent_cfg, "exploration_tool_reward_coef", 0.0) or 0.0)
+        max_bonus = self._cfg_get(agent_cfg, "exploration_tool_reward_max", None)
+        min_calls = int(self._cfg_get(agent_cfg, "exploration_tool_min_calls", 0) or 0)
+        missing_penalty = float(self._cfg_get(agent_cfg, "exploration_tool_missing_penalty", 0.0) or 0.0)
+
+        bonus = coef * max(non_finish_tool_calls, 0)
+        if max_bonus is not None:
+            bonus = min(bonus, float(max_bonus))
+        if min_calls > 0 and non_finish_tool_calls < min_calls:
+            bonus += missing_penalty
+        return bonus
