+    @staticmethod
+    def _is_tool_output_text(text: str) -> bool:
+        stripped = text.lstrip()
+        return stripped.startswith("Execution output of [") or stripped.startswith("Exit code:")
+
+    def _split_assistant_content_segments(self, content: str) -> list[dict]:
+        text = content if isinstance(content, str) else str(content)
+        if not text.strip():
+            return []
+        function_pattern = re.compile(r"<function=[\s\S]*?</function>")
+        segments = []
+        cursor = 0
+        segment_idx = 0
+        for match in function_pattern.finditer(text):
+            leading = text[cursor : match.start()].strip()
+            if leading:
+                segments.append(
+                    {
+                        "segment_idx": segment_idx,
+                        "segment_type": "model_output",
+                        "content_len": len(leading),
+                        "content_preview": self._preview_text(leading),
+                        "content": leading,
+                    }
+                )
+                segment_idx += 1
+            call_block = match.group(0).strip()
+            if call_block:
+                segments.append(
+                    {
+                        "segment_idx": segment_idx,
+                        "segment_type": "tool_call",
+                        "content_len": len(call_block),
+                        "content_preview": self._preview_text(call_block),
+                        "content": call_block,
+                    }
+                )
+                segment_idx += 1
+            cursor = match.end()
+        trailing = text[cursor:].strip()
+        if trailing:
+            trailing_type = "tool_result" if self._is_tool_output_text(trailing) else "model_output"
+            segments.append(
+                {
+                    "segment_idx": segment_idx,
+                    "segment_type": trailing_type,
+                    "content_len": len(trailing),
+                    "content_preview": self._preview_text(trailing),
+                    "content": trailing,
+                }
+            )
+        if not segments:
+            segments.append(
+                {
+                    "segment_idx": 0,
+                    "segment_type": "model_output",
+                    "content_len": len(text),
+                    "content_preview": self._preview_text(text),
+                    "content": text,
+                }
+            )
+        return segments
+
+    def _classify_message_type(self, role: str, content: str) -> str:
+        role = role or "unknown"
+        if role == "system":
+            return "system_prompt"
+        if role == "user":
+            return "tool_result" if self._is_tool_output_text(content) else "user_prompt"
+        if role == "tool":
+            return "tool_result"
+        if role == "assistant":
+            return "tool_call" if "<function=" in content else "model_output"
+        return "unknown"
+
+    def _parse_role_tagged_input(self, input_text: str) -> list[dict]:
+        text = input_text if isinstance(input_text, str) else str(input_text)
+        role_pattern = re.compile(r"(?m)^(system|user|assistant|tool)\n")
+        matches = list(role_pattern.finditer(text))
+        if not matches:
+            return [
+                {
+                    "section_idx": 0,
+                    "role": "combined",
+                    "section_type": "prompt",
+                    "content_len": len(text),
+                    "content_preview": self._preview_text(text),
+                    "content": text,
+                }
+            ]
+
+        sections = []
+        for idx, match in enumerate(matches):
+            role = match.group(1)
+            start = match.end()
+            end = matches[idx + 1].start() if idx + 1 < len(matches) else len(text)
+            content = text[start:end].strip()
+            if not content:
+                continue
+            section_type = self._classify_message_type(role, content)
+            entry = {
+                "section_idx": len(sections),
+                "role": role,
+                "section_type": section_type,
+                "content_len": len(content),
+                "content_preview": self._preview_text(content),
+                "content": content,
+            }
+            if role == "assistant":
+                entry["segments"] = self._split_assistant_content_segments(content)
+            sections.append(entry)
+        return sections
+
+    def _parse_rollout_output_timeline(self, output_text: str) -> list[dict]:
+        text = output_text if isinstance(output_text, str) else str(output_text)
+        if not text.strip():
+            return []
+
+        function_pattern = re.compile(r"<function=[\s\S]*?</function>")
+        tool_output_pattern = re.compile(
+            r"(?:^|\n)(?:Exit code:[^\n]*\n)?Execution output of \[[^\]]+\]:[\s\S]*?(?=(?:\n<function=|\n(?:Exit code:[^\n]*\n)?Execution output of \[|\Z))",
+            re.MULTILINE,
+        )
+
+        spans = []
+        for match in function_pattern.finditer(text):
+            spans.append((match.start(), match.end(), "tool_call"))
+        for match in tool_output_pattern.finditer(text):
+            spans.append((match.start(), match.end(), "tool_result"))
+        spans.sort(key=lambda x: (x[0], x[1]))
+
+        timeline = []
+        cursor = 0
+        for start, end, seg_type in spans:
+            if start < cursor:
+                continue
+            leading = text[cursor:start].strip()
+            if leading:
+                timeline.append(
+                    {
+                        "segment_idx": len(timeline),
+                        "segment_type": "model_output",
+                        "content_len": len(leading),
+                        "content_preview": self._preview_text(leading),
+                        "content": leading,
+                    }
+                )
+            segment_text = text[start:end].strip()
+            if segment_text:
+                timeline.append(
+                    {
+                        "segment_idx": len(timeline),
+                        "segment_type": seg_type,
+                        "content_len": len(segment_text),
+                        "content_preview": self._preview_text(segment_text),
+                        "content": segment_text,
+                    }
+                )
+            cursor = end
+
+        trailing = text[cursor:].strip()
+        if trailing:
+            timeline.append(
+                {
+                    "segment_idx": len(timeline),
+                    "segment_type": "model_output",
+                    "content_len": len(trailing),
+                    "content_preview": self._preview_text(trailing),
+                    "content": trailing,
+                }
+            )
+        if not timeline:
+            timeline.append(
+                {
+                    "segment_idx": 0,
+                    "segment_type": "model_output",
+                    "content_len": len(text),
+                    "content_preview": self._preview_text(text),
+                    "content": text,
+                }
+            )
+        return timeline
