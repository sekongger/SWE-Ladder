+def truncate_to_first_function_call(response_text: str) -> str:
+    """
+    Keep only:
+    - text before the first <function=...></function> block
+    - the first function block itself
+    Drop any trailing free-form text after that first tool call.
+    """
+    text = response_text if isinstance(response_text, str) else str(response_text)
+    match = FUNCTION_BLOCK_PATTERN.search(text)
+    if not match:
+        return text
+
+    prefix = text[: match.start()].strip()
+    function_block = match.group(1).strip()
+    if prefix:
+        return f"{prefix}\n\n{function_block}"
+    return function_block
+
