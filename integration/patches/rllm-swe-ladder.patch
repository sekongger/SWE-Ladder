+def split_staged_opd_observation(observation: str) -> tuple[str, str] | None:
+    """
+    Split staged OPD ``[SYSTEM]``/``[USER]`` text emitted by the dataset builder.
+
+    Staged samples already contain the student-visible task prompt. Wrapping that
+    text in the generic SWE repair template injects patch/reproduction
+    instructions into localization/reproduction sub-tasks, so these samples must
+    be passed through directly.
+
+    The ``## Stage`` heading used to be required as the marker of a staged sample.
+    That is wrong under ``OPD_END_TO_END_PROMPT=1``: the end-to-end student templates
+    deliberately carry NO stage heading (invariant I2 - the student prompt must be
+    identical across stages, and invariant I1 - it must equal the eval prompt byte
+    for byte, which has no such heading). Rejecting them here made the agent fall
+    back to the ``OPENHANDS_SYSTEM_PROMPT``/``SWE_SYSTEM_PROMPT`` code constant and
+    nest the whole rendered prompt inside the generic template's
+    ``<issue_description>``, i.e. train silently diverged from eval on every
+    end-to-end run. Under end-to-end the ``[SYSTEM]``/``[USER]`` framing itself is
+    the marker; the regex below already requires the text to start with
+    ``[SYSTEM]`` and contain a ``[USER]`` section, which a repository observation
+    does not.
+    """
+
+    text = observation if isinstance(observation, str) else str(observation)
+    match = STAGED_OPD_MESSAGES_PATTERN.match(text)
+    if not match:
+        return None
+
+    system_text = match.group("system").strip()
+    user_text = match.group("user").strip()
+    if "## Stage" not in user_text and not _end_to_end_prompt_enabled():
+        return None
+    return system_text, user_text
+
+
+def _end_to_end_prompt_enabled() -> bool:
+    """Mirror of rllm.opd.runtime_prompt._end_to_end_enabled (kept local: this module
+    is imported by Ray workers before the opd package is guaranteed to be importable)."""
+    return os.environ.get("OPD_END_TO_END_PROMPT", "0") == "1"
+
+
+def merge_staged_system_prompt(staged_system: str, base_system: str) -> str:
+    """Merge staged OPD system text with the agent base system without duplicating tools."""
+
+    staged_system = (staged_system or "").strip()
+    base_system = (base_system or "").strip()
+    if not staged_system:
+        return base_system
+    if not base_system:
+        return staged_system
+    if staged_system == base_system:
+        return staged_system
+    if base_system in staged_system:
+        return staged_system
+    if staged_system in base_system:
+        return base_system
+    # A staged prompt that carries its own function blocks is already the
+    # complete model-facing system prompt. Appending SWEAGENT_SYSTEM_PROMPT
+    # would create two competing schemas (bash and execute_bash).
+    if "BEGIN FUNCTION #" in staged_system:
+        return staged_system
+    return f"{staged_system}\n\n{base_system}"
+
