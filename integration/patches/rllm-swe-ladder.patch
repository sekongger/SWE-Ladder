+    def _drop_pipeline_concat_meta_info(self, batch: DataProto) -> DataProto:
+        """Normalize post-update mini-batches before concatenating for logging."""
+
+        for key in ("global_token_num", "calculate_entropy", "topk_k", "last_mini_batch"):
+            batch.meta_info.pop(key, None)
