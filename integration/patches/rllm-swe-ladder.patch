+    def _infer_min_checkpoint_bucket_mb(self) -> int:
+        """Infer a bucket that can hold the model's largest embedding tensor.
+
+        HCCL and the downstream vLLM IPC sender both require a single tensor to
+        fit in one update bucket, so size the bucket using the transfer dtype.
+        """
+
+        min_bucket_mb = 896
+        model_path = str(self.config.actor_rollout_ref.model.path)
+        config_path = os.path.join(model_path, "config.json")
+        try:
+            with open(config_path, encoding="utf-8") as f:
+                model_config = json.load(f)
+            vocab_size = int(model_config.get("vocab_size") or 0)
+            hidden_size = int(model_config.get("hidden_size") or 0)
+        except Exception:
+            return min_bucket_mb
+
+        if vocab_size <= 0 or hidden_size <= 0:
+            return min_bucket_mb
+
+        bytes_per_param = self._checkpoint_weight_transfer_bytes_per_param()
+        embedding_mb = math.ceil(vocab_size * hidden_size * bytes_per_param / (1024 * 1024))
+        # Leave a little metadata/rounding room and round to a coarse boundary.
+        return max(min_bucket_mb, math.ceil(embedding_mb * 1.05 / 128) * 128)
