+import base64
+import re
+import shlex
+
+
+FILE_EXISTS_MARKER = "__RLLM_ISSUE_REPRODUCTION_FILE_EXISTS__"
+BUGGY_EXIT_MARKER = "__RLLM_ISSUE_REPRODUCTION_BUGGY_EXIT__"
+PATCH_APPLY_EXIT_MARKER = "__RLLM_ISSUE_REPRODUCTION_PATCH_APPLY_EXIT__"
+PATCHED_EXIT_MARKER = "__RLLM_ISSUE_REPRODUCTION_PATCHED_EXIT__"
+
+
+def flag_enabled(value, *, default: bool = False) -> bool:
+    if value is None:
+        return default
+    if isinstance(value, bool):
+        return value
+    return str(value).strip().lower() not in {"0", "false", "no", "off", ""}
+
+
+def build_issue_reproduction_verifier_command(
+    script_path: str,
+    gold_patch: str = "",
+    *,
+    reverse_patch: bool = False,
+) -> str:
+    quoted_script = shlex.quote(script_path)
+    patch_b64 = base64.b64encode((gold_patch or "").encode("utf-8")).decode("ascii")
+    patch_b64_literal = shlex.quote(patch_b64)
+    patch_write_py = (
+        "import base64,sys; "
+        "open(sys.argv[1], 'wb').write(base64.b64decode(sys.argv[2]))"
+    )
+
+    git_apply = "git apply -R --whitespace=nowarn" if reverse_patch else "git apply --whitespace=nowarn"
+
+    shell_script = f"""
+set +e
+cd /testbed || {{
+  echo {FILE_EXISTS_MARKER}=0
+  echo {BUGGY_EXIT_MARKER}=
+  echo {PATCH_APPLY_EXIT_MARKER}=
+  echo {PATCHED_EXIT_MARKER}=
+  exit 0
+}}
+if command -v python3 >/dev/null 2>&1; then PY=python3; else PY=python; fi
+SCRIPT={quoted_script}
+PATCH_FILE=/tmp/rllm_issue_reproduction_gold.patch
+if [ ! -s "$SCRIPT" ]; then
+  echo {FILE_EXISTS_MARKER}=0
+  echo {BUGGY_EXIT_MARKER}=
+  echo {PATCH_APPLY_EXIT_MARKER}=
+  echo {PATCHED_EXIT_MARKER}=
+  exit 0
+fi
+echo {FILE_EXISTS_MARKER}=1
+$PY "$SCRIPT"
+BUGGY_EXIT=$?
+echo {BUGGY_EXIT_MARKER}=$BUGGY_EXIT
+if [ -z {patch_b64_literal} ]; then
+  echo {PATCH_APPLY_EXIT_MARKER}=
+  echo {PATCHED_EXIT_MARKER}=
+  exit 0
+fi
+$PY -c {shlex.quote(patch_write_py)} "$PATCH_FILE" {patch_b64_literal}
+PATCH_WRITE_EXIT=$?
+if [ "$PATCH_WRITE_EXIT" -ne 0 ]; then
+  echo {PATCH_APPLY_EXIT_MARKER}=-999
+  echo {PATCHED_EXIT_MARKER}=
+  exit 0
+fi
+{git_apply} "$PATCH_FILE"
+PATCH_APPLY_EXIT=$?
+echo {PATCH_APPLY_EXIT_MARKER}=$PATCH_APPLY_EXIT
+if [ "$PATCH_APPLY_EXIT" -ne 0 ]; then
+  echo {PATCHED_EXIT_MARKER}=
+  exit 0
+fi
+$PY "$SCRIPT"
+PATCHED_EXIT=$?
+echo {PATCHED_EXIT_MARKER}=$PATCHED_EXIT
+exit 0
+"""
+    return f"bash -lc {shlex.quote(shell_script)}"
+
+
+def _marker_int(output_text: str, marker: str) -> int | None:
+    match = re.search(rf"^{re.escape(marker)}=(-?\d*)$", output_text, flags=re.MULTILINE)
+    if not match:
+        return None
+    value = match.group(1)
+    if value == "":
+        return None
+    try:
+        return int(value)
+    except ValueError:
+        return None
+
+
+def parse_issue_reproduction_verifier_output(output_text: str) -> dict[str, int | None]:
+    return {
+        "file_exists": _marker_int(output_text, FILE_EXISTS_MARKER),
+        "buggy_exit_code": _marker_int(output_text, BUGGY_EXIT_MARKER),
+        "patch_apply_exit_code": _marker_int(output_text, PATCH_APPLY_EXIT_MARKER),
+        "patched_exit_code": _marker_int(output_text, PATCHED_EXIT_MARKER),
+    }
+
+
+def score_issue_reproduction_verifier(parsed: dict[str, int | None], *, has_gold_patch: bool) -> dict[str, float]:
+    file_exists = parsed.get("file_exists") == 1
+    buggy_exit = parsed.get("buggy_exit_code")
+    patch_apply_exit = parsed.get("patch_apply_exit_code")
+    patched_exit = parsed.get("patched_exit_code")
+
+    buggy_failed = file_exists and buggy_exit is not None and buggy_exit != 0
+    patch_applied = has_gold_patch and patch_apply_exit == 0
+    patched_passed = patch_applied and patched_exit == 0
+    if has_gold_patch:
+        score = 1.0 if (buggy_failed and patched_passed) else 0.0
+    else:
+        score = 1.0 if buggy_failed else 0.0
+
+    return {
+        "score": score,
+        "file_exists": 1.0 if file_exists else 0.0,
+        "buggy_failed": 1.0 if buggy_failed else 0.0,
+        "patch_available": 1.0 if has_gold_patch else 0.0,
