+                        ),
+                        "data_parallel_size": 1,
+                        "expert_parallel_size": 1,
+                        "tensor_model_parallel_size": _select_config(
+                            config, "actor_rollout_ref.rollout.tensor_model_parallel_size", 1
+                        ),
+                        "max_num_batched_tokens": _select_config(
+                            config, "actor_rollout_ref.rollout.max_num_batched_tokens", 8192
+                        ),
+                        "max_model_len": _select_config(config, "actor_rollout_ref.rollout.max_model_len", None),
+                        "max_num_seqs": _select_config(config, "actor_rollout_ref.rollout.max_num_seqs", 1024),
+                        "load_format": _select_config(config, "actor_rollout_ref.rollout.load_format", "auto"),
+                        "engine_kwargs": _select_config(config, "actor_rollout_ref.rollout.engine_kwargs", {}),
+                        "limit_images": None,
+                        "enable_chunked_prefill": _select_config(
+                            config, "actor_rollout_ref.rollout.enable_chunked_prefill", True
+                        ),
+                        "enable_prefix_caching": _select_config(
+                            config, "actor_rollout_ref.rollout.enable_prefix_caching", True
+                        ),
+                        "disable_log_stats": _select_config(
+                            config, "actor_rollout_ref.rollout.disable_log_stats", True
+                        ),
+                        "skip_tokenizer_init": False,
+                        "prompt_length": _select_config(config, "data.max_prompt_length", 2048),
+                        "response_length": _select_config(config, "data.max_response_length", 2048),
+                    },
+                },
+                "sandbox_fusion": {
+                    "url": None,
+                    "max_concurrent": 64,
+                    "memory_limit_mb": 1024,
+                },
+            }
+        }
+    )
+
+    config = OmegaConf.merge(reward_defaults, config)
+
+    legacy_rollout = _select_config(config, "reward_model.rollout", None)
+    legacy_sandbox = _select_config(config, "reward_model.sandbox_fusion", None)
+
+    with open_dict(config):
+        # Migrate legacy rllm config fields into verl's new reward schema.
+        if _select_config(config, "custom_reward_function.path", None) is not None:
+            config.reward.custom_reward_function.path = config.custom_reward_function.path
+        if _select_config(config, "custom_reward_function.name", None) is not None:
+            config.reward.custom_reward_function.name = config.custom_reward_function.name
+
+        if _select_config(config, "reward_model.reward_manager", None) is not None:
+            config.reward.reward_manager.name = config.reward_model.reward_manager
+        if _select_config(config, "reward_model.reward_loop_source", None) is not None:
+            config.reward.reward_manager.source = config.reward_model.reward_loop_source
+            config.reward.reward_manager.module.path = _select_config(
+                config, "reward_model.reward_loop_module_path", None
+            )
+            config.reward.reward_manager.module.name = _select_config(
+                config, "reward_model.reward_loop_class_name", "custom_reward_manager"
+            )
+
+        for key in ("enable", "enable_resource_pool", "n_gpus_per_node", "nnodes"):
+            legacy_value = _select_config(config, f"reward_model.{key}", None)
+            if legacy_value is not None:
+                config.reward.reward_model[key] = legacy_value
+
+        legacy_model_path = _select_config(config, "reward_model.model.path", None)
+        if legacy_model_path is not None:
+            config.reward.reward_model.model_path = legacy_model_path
+
+        if legacy_rollout is not None:
+            for key, value in _to_plain_dict(legacy_rollout).items():
+                if value is not None:
+                    config.reward.reward_model.rollout[key] = value
+
+        legacy_reward_kwargs = _select_config(config, "reward_model.reward_kwargs", None)
+        if legacy_reward_kwargs is not None:
+            config.reward.reward_kwargs = _to_plain_dict(legacy_reward_kwargs)
+
+        if legacy_sandbox is not None:
+            for key, value in _to_plain_dict(legacy_sandbox).items():
+                if value is not None:
+                    config.reward.sandbox_fusion[key] = value
+
+    return config
