+ANSWER_MARKER_COMMENT_PHRASES = (
+    "Error",
+    "Order altered",
+    "Swapped arguments",
+    "Logic altered",
+    "Return order altered",
+)
+
+
+def sanitize_swe_observation(text: object) -> str:
+    """Remove synthetic answer-marker comments from tool observations."""
+
+    if text is None:
+        return ""
+
+    sanitized_lines: list[str] = []
+    for line in str(text).splitlines():
+        if "#" in line:
+            code, comment = line.split("#", 1)
+            if comment.strip() in ANSWER_MARKER_COMMENT_PHRASES:
+                line = code.rstrip()
+        sanitized_lines.append(line)
+    return "\n".join(sanitized_lines)
