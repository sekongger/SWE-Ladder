+def _build_sync_reward_manager(config, tokenizer, num_examine: int, **reward_kwargs):
+    from verl.trainer.ppo.reward import get_custom_reward_fn
+    from verl.utils.reward_score import default_compute_score
+
+    manager_source = _select_config(config, "reward.reward_manager.source", "register")
+    manager_name = _select_config(config, "reward.reward_manager.name", "naive")
+
+    if manager_source == "register":
+        from verl.workers.reward_manager import get_reward_manager_cls
+
+        reward_manager_cls = get_reward_manager_cls(manager_name)
+    elif manager_source == "importlib":
+        from verl.utils.import_utils import load_extern_object
+
+        module_path = _select_config(config, "reward.reward_manager.module.path", None)
+        if module_path is None:
+            raise ValueError("config.reward.reward_manager.module.path is required when source=importlib")
+        reward_manager_cls = load_extern_object(module_path=module_path, object_name=manager_name)
+    else:
+        raise ValueError(f"Unsupported reward manager source for sync trainer: {manager_source}")
+
+    compute_score = get_custom_reward_fn(config)
+    if compute_score is None:
+        sandbox_config = _select_config(config, "reward.sandbox_fusion", None)
+        sandbox_config = _to_plain_dict(sandbox_config) if sandbox_config is not None else {}
+        sandbox_url = sandbox_config.get("url")
+        if sandbox_url:
+            sandbox_manager = multiprocessing.Manager()
+            concurrent_semaphore = sandbox_manager.Semaphore(sandbox_config.get("max_concurrent", 64))
+            compute_score = partial(
+                default_compute_score,
+                sandbox_fusion_url=sandbox_url,
+                concurrent_semaphore=concurrent_semaphore,
+                memory_limit_mb=sandbox_config.get("memory_limit_mb", 1024),
+            )
+        else:
+            compute_score = default_compute_score
+
+    if _callable_is_async(compute_score):
+        raise TypeError(
+            "AgentPPOTrainer requires a synchronous reward function, "
+            "but config.reward.custom_reward_function points to an async callable."
+        )
+
+    signature = inspect.signature(reward_manager_cls.__init__)
+    parameters = signature.parameters
+    accepts_var_kwargs = any(param.kind == inspect.Parameter.VAR_KEYWORD for param in parameters.values())
+
+    candidate_kwargs = {
+        "config": config,
+        "tokenizer": tokenizer,
+        "num_examine": num_examine,
+        "compute_score": compute_score,
+        "reward_fn_key": _select_config(config, "data.reward_fn_key", "data_source"),
+        **reward_kwargs,
+    }
+
+    init_kwargs = {}
+    for key, value in candidate_kwargs.items():
+        if accepts_var_kwargs or key in parameters:
+            init_kwargs[key] = value
+
+    reward_manager = reward_manager_cls(**init_kwargs)
+    if not callable(reward_manager):
+        raise TypeError(
+            f"Reward manager {reward_manager_cls.__name__} is not callable and cannot be used by AgentPPOTrainer."
+        )
+    return reward_manager
+
