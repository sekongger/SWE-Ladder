+            entry = {
+                "msg_idx": i,
+                "role": role,
+                "message_type": message_type,
+                "content_preview": self._preview_text(text),
+                "content_len": len(text),
+            }
+            if role == "assistant":
+                turn_idx += 1
+                entry["turn"] = turn_idx
+                entry["segments"] = self._split_assistant_content_segments(text)
+            elif role == "tool":
+                entry["segments"] = [
