+        # Actor/ref updates run immediately before rollout weight sync. Drop
+        # allocator cache once here, not inside every actor mini-batch update,
+        # so checkpoint-engine transfer buffers have headroom without slowing
+        # each PPO micro-step.
+        self.actor_wg.clear_device_cache()
