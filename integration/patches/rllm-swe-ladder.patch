+        termination_reason: str | None = None,
+    ):
+        total_non_finish_tool_calls = count_non_finish_tool_calls(chat_completion)
+        successful_non_finish_tool_calls = count_successful_non_finish_tool_calls(chat_completion)
+        exploration_reward = self._exploration_tool_reward(successful_non_finish_tool_calls)
+        agent_cfg = self._cfg_get(self.config, "agent", {})
+        no_tool_call_penalty = 0.0
+        give_up_empty_patch_penalty = 0.0
+        if termination_reason == "NO_TOOL_CALL":
+            no_tool_call_penalty = float(
+                self._cfg_get(agent_cfg, "exploration_no_tool_call_penalty", 0.0) or 0.0
+            )
+            shaped_score = no_tool_call_penalty
+        else:
+            shaped_score = float(raw_score) + exploration_reward
+            # Distinguish "early give-up" from "long failure". A trajectory that
+            # voluntarily finished (finish/submit -> ENV_DONE, or empty reason) yet
+            # neither solved the task nor edited any source file effectively handed
+            # in an empty patch. Penalizing this makes early give-up strictly worse
+            # than a truncated/max-steps trajectory that kept trying, counteracting
+            # the length/step collapse observed under sparse GRPO. Budget-exhaustion
+            # reasons (TRUNCATION / MAX_STEPS / *_TIMEOUT / INVALID_TOOL_CALL_LIMIT)
+            # are excluded so genuine effort is not punished.
+            give_up_penalty_cfg = float(
+                self._cfg_get(agent_cfg, "give_up_empty_patch_penalty", 0.0) or 0.0
+            )
+            if give_up_penalty_cfg != 0.0 and termination_reason in _VOLUNTARY_FINISH_REASONS:
+                if float(raw_score) <= 0.0 and count_successful_edit_calls(chat_completion) == 0:
+                    give_up_empty_patch_penalty = give_up_penalty_cfg
+                    shaped_score = shaped_score + give_up_empty_patch_penalty
+
+        clamp_min = self._cfg_get(agent_cfg, "exploration_reward_clamp_min", None)
+        clamp_max = self._cfg_get(agent_cfg, "exploration_reward_clamp_max", None)
+        if clamp_min is not None:
+            shaped_score = max(float(clamp_min), shaped_score)
+        if clamp_max is not None:
+            shaped_score = min(float(clamp_max), shaped_score)
+
+        return shaped_score, {
+            "raw_trajectory_reward": float(raw_score),
+            "exploration_non_finish_tool_calls": float(successful_non_finish_tool_calls),
+            "exploration_successful_non_finish_tool_calls": float(successful_non_finish_tool_calls),
+            "exploration_total_non_finish_tool_calls": float(total_non_finish_tool_calls),
+            "exploration_tool_reward": float(exploration_reward),
+            "exploration_no_tool_call_penalty": float(no_tool_call_penalty),
+            "give_up_empty_patch_penalty": float(give_up_empty_patch_penalty),
+            "give_up_empty_patch_applied": float(give_up_empty_patch_penalty != 0.0),
+            "trajectory_reward_shaped": float(shaped_score),
+        }
+
+    def _opsd_config(self):
+        return self._cfg_get(self.config, "opd", {})
+
+    def _opsd_teacher_source(self) -> str:
+        opd_cfg = self._opsd_config()
+        return str(
+            self._cfg_get(opd_cfg, "teacher_source", os.environ.get("OPSD_TEACHER_SOURCE", "ref_policy"))
+        ).strip().lower()
+
+    @staticmethod
+    def _is_ref_policy_teacher_source(source: str) -> bool:
+        return source in {"ref", "ref_policy", "reference", "reference_policy"}
+
+    @staticmethod
+    def _is_actor_teacher_source(source: str) -> bool:
+        return source in {"actor", "self", "self_actor", "current_actor"}
+
+    def _opsd_enabled(self) -> bool:
+        opd_cfg = self._opsd_config()
+        actor_cfg = self.config.actor_rollout_ref.actor
+        return bool(
+            self._cfg_get(opd_cfg, "enabled", False)
+            or self._cfg_get(actor_cfg, "opd_loss_enabled", False)
+        )
+
+    def _rlsd_enabled(self) -> bool:
+        return flag_enabled(self._cfg_get(self.config.algorithm, "use_rlsd", False))
+
+    def _rlsd_uses_rollout_student_prior(self) -> bool:
+        return self._rlsd_enabled() and flag_enabled(
+            self._cfg_get(self.config.algorithm, "rlsd_use_rollout_logp_as_student_prior", False)
+        )
+
+    def _rlsd_uses_actor_teacher(self) -> bool:
+        return self._rlsd_enabled() and self._is_actor_teacher_source(self._opsd_teacher_source())
+
+    def _opsd_kl_enabled(self) -> bool:
+        configured = self._cfg_get(self.config.algorithm, "use_opsd_kl", None)
+        if configured is None:
+            return self._opsd_enabled() and not self._rlsd_enabled()
+        return flag_enabled(configured)
+
+    def _current_rlsd_lambda(self) -> float:
+        algorithm_cfg = self.config.algorithm
+        return compute_rlsd_lambda_schedule(
+            global_step=getattr(self, "global_steps", 1),
+            lambda_default=float(self._cfg_get(algorithm_cfg, "rlsd_lambda", 1.0)),
+            lambda_init=self._cfg_get(algorithm_cfg, "rlsd_lambda_init", None),
+            lambda_final=self._cfg_get(algorithm_cfg, "rlsd_lambda_final", None),
+            decay_steps=int(self._cfg_get(algorithm_cfg, "rlsd_lambda_decay_steps", 0) or 0),
+        )
+
+    def _validate_rlsd_configuration(self) -> None:
+        if not self._rlsd_enabled():
+            return
+        if self._opsd_kl_enabled():
+            raise ValueError("RLSD requires algorithm.use_opsd_kl=false; do not combine RLSD with OPSD KL loss")
+        if not self._opsd_enabled():
+            raise ValueError("RLSD requires opd.enabled=true so privileged teacher inputs are constructed")
+        if self._opsd_uses_sdpo_policy_loss():
+            raise ValueError("RLSD requires opd_policy_loss_mode=auxiliary so the GRPO policy loss remains active")
+        if not (
+            self._is_ref_policy_teacher_source(self._opsd_teacher_source())
+            or self._is_actor_teacher_source(self._opsd_teacher_source())
+        ):
+            raise NotImplementedError("RLSD sampled-token evidence supports teacher_source=ref_policy or actor")
+        if str(self.config.algorithm.adv_estimator).strip().lower() != "grpo":
+            raise ValueError("RLSD currently requires algorithm.adv_estimator=grpo")
+        if not flag_enabled(self._cfg_get(self.config.algorithm, "rlsd_use_old_student_logp", True)):
+            raise NotImplementedError("RLSD currently uses old_log_probs as student prior evidence")
+        if not flag_enabled(self._cfg_get(self.config.algorithm, "rlsd_teacher_no_grad", True)):
+            raise ValueError("RLSD teacher scoring must run without gradients")
+        self._current_rlsd_lambda()
+
+    def _attach_actor_rlsd_meta_info(self, batch: DataProto) -> dict[str, float]:
+        """Move local self-teacher scoring into actor micro-batch updates."""
+
+        self._validate_rlsd_configuration()
+        if not self._rlsd_uses_actor_teacher():
+            return {}
+        lambda_rlsd = self._current_rlsd_lambda()
+        batch.meta_info["rlsd_actor_teacher"] = {
+            "enabled": True,
+            "lambda_rlsd": lambda_rlsd,
+            "weight_clip_eps": float(self._cfg_get(self.config.algorithm, "rlsd_weight_clip_eps", 0.2)),
+            "delta_clip": float(self._cfg_get(self.config.algorithm, "rlsd_delta_clip", 5.0)),
+            "log_stats": flag_enabled(self._cfg_get(self.config.algorithm, "rlsd_log_stats", True)),
+        }
+        return {
+            "rlsd_lambda": float(lambda_rlsd),
+            "use_rlsd": 1.0,
+            "use_opsd_kl": 0.0,
+            "opsd_kl_loss_not_added": 1.0,
+            "rlsd_teacher/source_is_actor": 1.0,
+        }
+
+    @staticmethod
+    def _zero_actor_update_metrics(reason: str) -> dict[str, float]:
+        return {
+            f"actor/{reason}": 1.0,
+            "actor/pg_loss": 0.0,
+            "actor/kl_loss": 0.0,
+            "actor/policy_loss_total": 0.0,
+            "actor/num_micro_batches": 0.0,
+            "actor/grad_norm": 0.0,
+        }
+
+    def _docker_tunnel_healthy(self) -> bool:
+        """Best-effort check that the remote docker endpoint (SSH tunnel) responds to /_ping."""
+        host = os.environ.get("DOCKER_HOST") or os.environ.get("R2EGYM_DOCKER_HOST") or ""
+        if not host.startswith("tcp://"):
+            # Unknown/unix socket -- cannot probe cheaply; assume healthy so we never block wrongly.
+            return True
+        url = "http://" + host[len("tcp://"):] + "/_ping"
+        try:
+            import urllib.request
+
+            with urllib.request.urlopen(url, timeout=5) as resp:  # noqa: S310 (localhost tunnel)
+                return resp.status == 200
+        except Exception:
+            return False
+
+    def _prepare_skipped_no_container_update(self, batch: DataProto) -> dict[str, float] | None:
+        """Veto the actor update when the batch is dominated by NO_CONTAINER failures.
+
+        A high NO_CONTAINER fraction means the rollout environment (remote docker via the SSH
+        tunnel) was unavailable, so every trajectory is a zero-reward stub. Running the optimizer
+        on it corrupts the policy with garbage -- the exact pathology that turned planA gs29-71
+        into contamination after the tunnel died at 2026-08-07 08:47:53. Instead we:
+          1) skip the actor/critic/OPSD update (weights stay clean),
+          2) block until the tunnel recovers (autossh reconnects), bounded by a timeout,
+        so the run self-heals on the next step instead of spinning zero-reward steps or
+        corrupting the checkpoint. Tunables via env:
+          NO_CONTAINER_GUARD_THRESHOLD (default 0.5), NO_CONTAINER_GUARD_WAIT_SECONDS (300),
+          NO_CONTAINER_GUARD_POLL_SECONDS (10). Set THRESHOLD>1 to disable.
+        """
+        threshold = float(os.environ.get("NO_CONTAINER_GUARD_THRESHOLD", "0.5"))
+        if threshold > 1.0:
+            return None
+        fraction = float(getattr(self, "_last_no_container_fraction", 0.0) or 0.0)
+        if fraction < threshold:
+            return None
+
+        n_no_container = int(getattr(self, "_last_no_container_count", 0) or 0)
+        n_traj = int(getattr(self, "_last_trajectory_count", 0) or 0)
+        msg = (
+            f"[NO_CONTAINER_GUARD] step={self.global_steps}: {n_no_container}/{n_traj} "
+            f"({100.0 * fraction:.1f}%) trajectories had NO_CONTAINER >= threshold {threshold:.2f}. "
+            f"INFRA OUTAGE (docker tunnel down) -- SKIPPING actor update to protect weights."
+        )
+        print(msg, flush=True)
+        wait_seconds = float(os.environ.get("NO_CONTAINER_GUARD_WAIT_SECONDS", "300"))
+        poll_seconds = max(1.0, float(os.environ.get("NO_CONTAINER_GUARD_POLL_SECONDS", "10")))
+        waited = 0.0
+        while waited < wait_seconds:
+            if self._docker_tunnel_healthy():
+                print(
+                    f"[NO_CONTAINER_GUARD] docker tunnel recovered after {waited:.0f}s; "
+                    f"resuming on next step.",
+                    flush=True,
+                )
+                break
+            time.sleep(poll_seconds)
+            waited += poll_seconds
+        else:
+            print(
+                f"[NO_CONTAINER_GUARD] docker tunnel STILL down after {wait_seconds:.0f}s; "
+                f"continuing to skip updates (weights preserved) until it returns.",
+                flush=True,
+            )
+
+        if "old_log_probs" not in batch.batch and "responses" in batch.batch:
+            batch.batch["old_log_probs"] = torch.zeros_like(batch.batch["responses"], dtype=torch.float32)
+
+        metrics = self._zero_actor_update_metrics("skipped_no_container")
+        metrics.update(
+            {
+                "rollout/no_container_fraction": fraction,
+                "rollout/skipped_no_container_update": 1.0,
+            }
+        )
+        return metrics
+
+    def _prepare_skipped_empty_actor_update(self, batch: DataProto) -> dict[str, float] | None:
+        """Skip actor updates that have no trainable response or OPSD tokens."""
+
+        response_mask = batch.batch.get("response_mask")
+        if response_mask is None:
+            return None
+
+        pg_loss_mask = batch.batch.get("pg_loss_mask")
+        active_pg_mask = response_mask.float()
+        if pg_loss_mask is not None:
+            active_pg_mask = active_pg_mask * pg_loss_mask.to(
+                device=response_mask.device, dtype=response_mask.dtype
+            ).float()
+        active_pg_tokens = float(active_pg_mask.detach().sum().cpu().item())
+
+        actor_cfg = self.config.actor_rollout_ref.actor
+        opsd_loss_enabled = flag_enabled(self._cfg_get(actor_cfg, "opd_loss_enabled", False))
+        opsd_loss_coef = float(self._cfg_get(actor_cfg, "opd_loss_coef", 0.0) or 0.0)
+        opsd_loss_mask = batch.batch.get("opsd_loss_mask")
+        active_opsd_tokens = 0.0
+        if opsd_loss_enabled and opsd_loss_coef != 0.0 and opsd_loss_mask is not None:
+            active_opsd_tokens = float(opsd_loss_mask.detach().float().sum().cpu().item())
+
+        if active_pg_tokens > 0.0 or active_opsd_tokens > 0.0:
+            return None
+
+        if "old_log_probs" not in batch.batch and "responses" in batch.batch:
+            batch.batch["old_log_probs"] = torch.zeros_like(batch.batch["responses"], dtype=torch.float32)
+
+        metrics = self._zero_actor_update_metrics("skipped_empty_update")
+        metrics.update(
+            {
+                "actor/skipped_empty_update_active_pg_tokens": active_pg_tokens,
+                "actor/skipped_empty_update_active_opsd_tokens": active_opsd_tokens,
+                "opsd/skipped_empty_update": 1.0,
+            }
+        )
+        return metrics
+
+    def _prepare_skipped_zero_rlsd_update(self, batch: DataProto) -> dict[str, float] | None:
+        """Avoid actor/ref forwards when an RLSD batch cannot produce a gradient."""
+
+        if not self._rlsd_enabled():
+            return None
+        actor_cfg = self.config.actor_rollout_ref.actor
+        if flag_enabled(self._cfg_get(actor_cfg, "use_kl_loss", False)):
+            return None
+        if float(self._cfg_get(actor_cfg, "entropy_coeff", 0.0) or 0.0) != 0.0:
+            return None
+        advantages = batch.batch.get("advantages")
+        if advantages is None or bool((advantages.detach() != 0).any().item()):
+            return None
+
+        zero_log_probs = torch.zeros_like(batch.batch["responses"], dtype=torch.float32)
+        if "old_log_probs" not in batch.batch:
+            batch.batch["old_log_probs"] = zero_log_probs
+        if (
+            not self._rlsd_uses_actor_teacher()
+            and self._current_rlsd_lambda() > 0.0
+            and "rlsd_teacher_sampled_log_probs" not in batch.batch
+        ):
+            batch.batch["rlsd_teacher_sampled_log_probs"] = zero_log_probs.clone()
+        return {
+            "rlsd/skipped_zero_advantage_update": 1.0,
+            "rlsd_teacher_scoring_skipped": 1.0,
+            "use_rlsd": 1.0,
+            "use_opsd_kl": 0.0,
+            "opsd_kl_loss_not_added": 1.0,
+            **self._zero_actor_update_metrics("skipped_zero_rlsd_update"),
+        }
+
+    def _apply_rlsd_token_advantage(self, batch: DataProto) -> tuple[DataProto, dict[str, float]]:
+        """Replace uniform GRPO advantage with detached privileged evidence weights."""
+
+        self._validate_rlsd_configuration()
+        forbidden = {"teacher_topk_token_ids", "teacher_topk_log_probs"} & set(batch.batch.keys())
+        if forbidden:
+            raise ValueError(f"RLSD must not receive OPSD Top-K KL tensors: {sorted(forbidden)}")
+        lambda_rlsd = self._current_rlsd_lambda()
+        required = {"advantages", "response_mask", "old_log_probs"}
+        if lambda_rlsd > 0.0:
+            required.add("rlsd_teacher_sampled_log_probs")
+        missing = required - set(batch.batch.keys())
+        if missing:
+            raise ValueError(f"RLSD is missing tensors required for advantage modulation: {sorted(missing)}")
+
+        advantages = batch.batch["advantages"]
+        response_mask = batch.batch["response_mask"].to(dtype=advantages.dtype)
+        active_tokens = response_mask.sum(dim=-1).clamp_min(1)
+        sequence_advantage = (advantages.detach() * response_mask).sum(dim=-1) / active_tokens
+        expected_grpo_advantage = sequence_advantage.unsqueeze(-1) * response_mask
+        if not torch.allclose(advantages.detach(), expected_grpo_advantage, atol=1e-5, rtol=1e-5):
+            raise ValueError("RLSD expects GRPO sequence-level advantages broadcast across response tokens")
+        if lambda_rlsd == 0.0:
+            batch.batch["advantages"] = expected_grpo_advantage.detach().to(dtype=advantages.dtype)
+            return batch, {
+                "rlsd_lambda": 0.0,
+                "rlsd_teacher_scoring_skipped": 1.0,
+                "use_rlsd": 1.0,
+                "use_opsd_kl": 0.0,
+                "opsd_kl_loss_not_added": 1.0,
+            }
+
+        log_stats = flag_enabled(self._cfg_get(self.config.algorithm, "rlsd_log_stats", True))
+        result = compute_rlsd_token_advantage(
+            sequence_advantage,
+            batch.batch["rlsd_teacher_sampled_log_probs"],
+            batch.batch["old_log_probs"],
+            response_mask,
+            lambda_rlsd=lambda_rlsd,
+            weight_clip_eps=float(self._cfg_get(self.config.algorithm, "rlsd_weight_clip_eps", 0.2)),
+            delta_clip=float(self._cfg_get(self.config.algorithm, "rlsd_delta_clip", 5.0)),
+            return_stats=log_stats,
+        )
+        if log_stats:
+            token_advantage, stats = result
+        else:
+            token_advantage, stats = result, {}
+        batch.batch["advantages"] = token_advantage.to(dtype=advantages.dtype)
+        stats.update(
+            {
+                "rlsd_lambda": float(lambda_rlsd),
+                "rlsd_teacher_scoring_skipped": 0.0,
+                "use_rlsd": 1.0,
+                "use_opsd_kl": 0.0,
+                "opsd_kl_loss_not_added": 1.0,
+            }
+        )
+        return batch, stats
+
+    def _opsd_uses_sdpo_policy_loss(self) -> bool:
+        actor_cfg = self.config.actor_rollout_ref.actor
+        mode = str(self._cfg_get(actor_cfg, "opd_policy_loss_mode", "auxiliary")).strip().lower()
+        return self._opsd_enabled() and mode in {"sdpo", "opsd", "opd"}
+
+    def _opsd_routes_success_grpo_failure_opsd(self) -> bool:
+        opd_cfg = self._opsd_config()
+        return bool(
+            self._opsd_enabled()
+            and flag_enabled(
+                self._cfg_get(
+                    opd_cfg,
+                    "route_success_grpo_failure_opsd",
+                    os.environ.get("OPSD_ROUTE_SUCCESS_GRPO_FAILURE_OPSD", "0"),
+                )
+            )
+        )
+
+    def _opsd_max_response_tokens_for_training(self) -> int:
+        """Return the response-length cutoff for OPSD imitation eligibility."""
+
+        opd_cfg = self._opsd_config()
+        configured = self._cfg_get(
+            opd_cfg,
+            "max_response_tokens_for_training",
+            os.environ.get("OPSD_MAX_RESPONSE_TOKENS_FOR_TRAINING", 0),
+        )
+        try:
+            return max(0, int(configured or 0))
+        except (TypeError, ValueError):
+            return 0
+
+    @staticmethod
+    def _causal_localization_reward_enabled() -> bool:
+        """Return whether exact stage1 file matches become trajectory reward."""
+
+        return flag_enabled(os.environ.get("CAUSAL_LOCALIZATION_REWARD_ENABLE", "0"))
+
+    @staticmethod
+    def _assistant_localization_artifact_text(chat_completion: list[dict] | None) -> str:
+        if not chat_completion:
+            return ""
+
+        for message in reversed(chat_completion):
+            if not isinstance(message, dict) or message.get("role") != "assistant":
+                continue
+            text = str(message.get("content") or "")
+            if "<function=finish" in text.lower() or "<function=submit" in text.lower():
+                return text
+        return ""
+
+    @classmethod
+    def _score_causal_localization_trajectory(cls, trajectory: dict, chat_completion: list[dict] | None) -> dict[str, float]:
+        """Score stage1 localization; caller controls whether it becomes reward."""
+
+        if trajectory.get("stage") != "causal_localization":
+            return {}
+
+        privileged_context = trajectory.get("privileged_context") or {}
+        teacher_pi = {}
+        if isinstance(privileged_context, dict):
+            teacher_pi = privileged_context.get("teacher_pi") or {}
+        if not isinstance(teacher_pi, dict):
+            teacher_pi = {}
+
+        gold_ranges = gold_ranges_from_sample({"teacher_pi": teacher_pi})
+        if not gold_ranges:
+            return {"causal_location_metric_available": 0.0}
+
+        artifact_text = cls._assistant_localization_artifact_text(chat_completion)
+        predicted_ranges = extract_location_predictions(artifact_text)
+        score = score_location_prediction(predicted_ranges, gold_ranges)
+        score["exact_file_match_reward"] = exact_file_match_reward(predicted_ranges, gold_ranges)
+
+        metrics: dict[str, float] = {
+            "causal_location_metric_available": 1.0,
+            "causal_location_predicted_range_count": float(len(predicted_ranges)),
+        }
+        for key, value in score.items():
+            if isinstance(value, bool):
+                metrics[f"causal_location_{key}"] = 1.0 if value else 0.0
+            elif isinstance(value, (int, float)):
+                metrics[f"causal_location_{key}"] = float(value)
+        return metrics
+
+
+    def _needs_standard_ref_log_prob(self) -> bool:
+        """Return whether PPO/GRPO needs the traditional ref_log_prob tensor."""
+
+        algorithm_cfg = self.config.algorithm
+        actor_cfg = self.config.actor_rollout_ref.actor
+        return bool(
+            self._cfg_get(algorithm_cfg, "use_kl_in_reward", False)
+            or self._cfg_get(actor_cfg, "use_kl_loss", False)
+        )
+
+    def _rollout_teacher_base_url(self) -> str | None:
+        """Return the OpenAI-compatible /v1 URL for the active async rollout server."""
+
+        manager = getattr(self, "async_rollout_manager", None)
+        server_addresses = getattr(manager, "server_addresses", None) or []
+        if not server_addresses:
+            return None
+
+        base_url = str(server_addresses[0]).strip()
+        if not base_url:
+            return None
+        if not base_url.startswith(("http://", "https://")):
+            base_url = f"http://{base_url}"
+        base_url = base_url.rstrip("/")
+        if not base_url.endswith("/v1"):
+            base_url = f"{base_url}/v1"
+        return base_url
+
+    def _rollout_teacher_model_name(self) -> str | None:
+        """Infer the served model name used by the rollout vLLM server."""
+
+        opd_cfg = self._opsd_config()
+        explicit_model_name = self._cfg_get(opd_cfg, "teacher_model_name", None)
+        if explicit_model_name:
+            return str(explicit_model_name)
+
+        rollout_cfg = self.config.actor_rollout_ref.rollout
+        prometheus_cfg = self._cfg_get(rollout_cfg, "prometheus", {})
+        served_model_name = self._cfg_get(prometheus_cfg, "served_model_name", None)
+        if served_model_name:
+            served_model_name = str(served_model_name)
+            return served_model_name.split("/")[-1]
+
+        model_path = self._cfg_get(self.config.actor_rollout_ref.model, "path", None)
+        if model_path:
+            return os.path.basename(str(model_path).rstrip("/"))
+        return os.environ.get("OPSD_TEACHER_MODEL") or os.environ.get("OPENAI_MODEL")
+
+    def _messages_to_prompt_token_ids(self, messages: list[dict[str, str]] | None) -> list[int] | None:
+        """Tokenize privileged teacher messages as a generation prompt."""
+
+        if hasattr(messages, "tolist"):
+            messages = messages.tolist()
+        if isinstance(messages, str):
+            try:
+                messages = json.loads(messages)
+            except json.JSONDecodeError:
+                messages = [{"role": "user", "content": messages}]
+        if not messages:
+            return None
+        if not isinstance(messages, (list, tuple)):
+            return None
+        messages = [dict(message) for message in messages if isinstance(message, dict)]
+        if not messages:
+            return None
+        with self._tokenizer_lock:
+            if hasattr(self.tokenizer, "apply_chat_template"):
+                token_ids = self.tokenizer.apply_chat_template(
+                    messages,
+                    tokenize=True,
+                    add_generation_prompt=True,
+                )
+                if isinstance(token_ids, torch.Tensor):
+                    token_ids = token_ids.detach().cpu().tolist()
+                return [int(token_id) for token_id in token_ids]
+
+            prompt_text = "\n\n".join(
+                f"{message.get('role', 'user')}:\n{message.get('content', '')}" for message in messages
+            )
+            return self.tokenizer.encode(prompt_text, add_special_tokens=False)
+
+    def _stage_routing_enabled(self) -> bool:
+        return os.environ.get("OPSD_STAGE_ROUTING", "0") == "1"
+
+    def _opsd_teacher_topk_stage_routed(self, batch, timing_raw, topk_k):
+        """3C: score the response under each stage's privileged context and splice the
+        teacher top-k per token by stage_token_ids. Returns a DataProto with the spliced
+        teacher_topk_token_ids / teacher_topk_log_probs, or None to fall back to single
+        context. Costs up to 3x ref-teacher forwards (only the stages present are needed,
+        but we score all 3 for simplicity; ref is grad-free)."""
+        # Discover the contiguous context slots present in the batch: 3 in stage
+        # mode, up to OPSD_GRAPH_FRONTIER_CONTEXTS in dynamic-frontier mode (one
+        # per establishment epoch).
+        stage_keys = []
+        s = 0
+        while f"opsd_teacher_input_ids_stage{s}" in batch.batch:
+            stage_keys.append(
+                (f"opsd_teacher_input_ids_stage{s}", f"opsd_teacher_attention_mask_stage{s}", f"opsd_teacher_position_ids_stage{s}")
+            )
+            s += 1
+        if "stage_token_ids" not in batch.batch or not stage_keys:
+            return None
+        orig = (
+            batch.batch["opsd_teacher_input_ids"],
+            batch.batch["opsd_teacher_attention_mask"],
+            batch.batch["opsd_teacher_position_ids"],
+        )
+        tids, lps = [], []
+        try:
+            for inp_k, att_k, pos_k in stage_keys:
+                batch.batch["opsd_teacher_input_ids"] = batch.batch[inp_k]
+                batch.batch["opsd_teacher_attention_mask"] = batch.batch[att_k]
+                batch.batch["opsd_teacher_position_ids"] = batch.batch[pos_k]
+                batch.meta_info["topk_k"] = topk_k
+                tk = self.ref_policy_wg.compute_ref_log_prob_with_topk(batch)
+                tids.append(tk.batch["teacher_topk_token_ids"])
+                lps.append(tk.batch["teacher_topk_log_probs"])
+        finally:
+            (
+                batch.batch["opsd_teacher_input_ids"],
+                batch.batch["opsd_teacher_attention_mask"],
+                batch.batch["opsd_teacher_position_ids"],
+            ) = orig
+        tid = torch.stack(tids, dim=0)  # [S, B, resp, k]
+        lp = torch.stack(lps, dim=0)
+        stage_ids = batch.batch["stage_token_ids"]  # [B, resp], -1 = pad (masked by opsd_loss_mask)
+        resp_len = tid.shape[2]
+        stage_ids = stage_ids[:, :resp_len].clamp(min=0, max=len(stage_keys) - 1).to(tid.device)
+        idx = stage_ids[None, :, :, None].expand(1, stage_ids.shape[0], resp_len, tid.shape[-1])
+        tid_sel = tid.gather(0, idx).squeeze(0)
+        lp_sel = lp.gather(0, idx).squeeze(0)
+        # Free the per-stage teacher-input variants now that they've been scored, so the
+        # heavy [B, prompt+resp] tensors don't ride into the actor update / dispatch.
+        for inp_k, att_k, pos_k in stage_keys:
+            for k in (inp_k, att_k, pos_k):
+                try:
+                    del batch.batch[k]
+                except Exception:
+                    pass
+        from verl import DataProto as _DP
+        return _DP.from_dict(tensors={"teacher_topk_token_ids": tid_sel, "teacher_topk_log_probs": lp_sel})
+
+    def _stage_teacher_lookup(self):
+        """Lazily load {instance_id: {stage: teacher_messages}} from the three staged
+        parquets (dir is the parent of the training stage dir). Cached; {} on failure."""
+        cache = getattr(self, "_stage_teacher_lookup_cache", None)
+        if cache is not None:
+            return cache
+        lookup = {}
+        try:
+            train_files = self.config.data.train_files
+            if isinstance(train_files, (list, tuple)):
+                train_files = train_files[0]
+            base_dir = os.path.dirname(os.path.dirname(str(train_files)))
+            lookup = load_staged_teacher_messages(base_dir)
+            print(f"[stage-routing] loaded staged teacher_messages for {len(lookup)} instances from {base_dir}", flush=True)
+        except Exception as exc:  # never crash training over the lookup
+            print(f"[stage-routing] WARN failed to load staged teacher_messages: {exc!r}", flush=True)
+            lookup = {}
+        self._stage_teacher_lookup_cache = lookup
+        return lookup
+
+    def _build_opsd_ref_policy_teacher_inputs(
+        self,
+        *,
+        prompts_batch: torch.Tensor,
+        response_batch: torch.Tensor,
+        traj_mask: torch.Tensor,
+        valid_response_lengths: torch.Tensor,
+        teacher_messages_batch: list[list[dict[str, str]] | None] | None = None,
+        stage_ids_batch: torch.Tensor | None = None,
+        teacher_messages_by_stage: list | None = None,
+    ) -> tuple[dict[str, torch.Tensor], dict[str, float]]:
+        """Build teacher-only prompt tensors for local privileged policy scoring.
+
+        For end-to-end OPSD stage routing (3C, consumed downstream): stage_ids_batch is a
+        [B, resp_len] tensor of per-token stage ids (-1 = pad/no-stage), and
+        teacher_messages_by_stage[i] maps stage_id -> that instance's stage-specific
+        teacher_messages. When both are provided and stage routing is enabled, the teacher
+        should score each token under its stage's privileged context and splice per token.
+        Currently plumbed through (3B); the multi-context scoring/splice is the 3C step in
+        the ref worker.
+        """
+
+        if not self._opsd_enabled():
+            return {}, {}
+
+        source = self._opsd_teacher_source()
+        if not (
+            self._is_ref_policy_teacher_source(source)
+            or (self._rlsd_enabled() and self._is_actor_teacher_source(source))
+        ):
+            return {}, {}
+
+        from verl.utils.torch_functional import pad_sequence_to_length
+
+        opd_cfg = self._opsd_config()
+        pad_id = self.tokenizer.pad_token_id
+        if pad_id is None:
+            pad_id = 0
+
+        max_response_length = response_batch.shape[1]
+        max_prompt_length = int(self.config.data.max_prompt_length)
+        max_tokens_per_sample = int(self._cfg_get(opd_cfg, "max_tokens_per_sample", 0))
+
+        def _teacher_seq_from_messages(messages_list):
+            """Build (input_ids, attn, pos, n_privileged) for a per-trajectory teacher
+            messages list: privileged prompt prefix + the sampled student response suffix."""
+            tensors = []
+            n_priv = 0
+            for i in range(response_batch.shape[0]):
+                msgs = (
+                    messages_list[i]
+                    if messages_list is not None and i < len(messages_list)
+                    else None
+                )
+                prompt_ids = self._messages_to_prompt_token_ids(msgs)
+                if prompt_ids:
+                    n_priv += 1
+                else:
+                    prompt_ids = prompts_batch[i][prompts_batch[i] != pad_id].detach().cpu().tolist()
+                if len(prompt_ids) > max_prompt_length:
+                    prompt_ids = prompt_ids[-max_prompt_length:]
+                tensors.append(torch.tensor(prompt_ids, dtype=torch.long))
+            pb = torch.nn.utils.rnn.pad_sequence(
+                [torch.flip(ids, dims=[0]) for ids in tensors], batch_first=True, padding_value=pad_id
+            ).flip(dims=[1])
+            pb = pad_sequence_to_length(pb, max_prompt_length, pad_id, left_pad=True)
+            inp = torch.concat([pb, response_batch], dim=1)
+            if not torch.equal(inp[:, -max_response_length:], response_batch):
+                raise AssertionError("Privileged teacher response suffix must equal sampled student response ids")
+            att = torch.where(inp != pad_id, 1, 0)
+            pos = (torch.cumsum(att, dim=1) - 1) * att
+            return inp, att, pos, n_priv
+
+        # Default (single-context) teacher sequence — unchanged behavior.
+        teacher_input_ids, teacher_attention_mask, teacher_position_ids, privileged_context_samples = (
+            _teacher_seq_from_messages(teacher_messages_batch)
+        )
+
+        # 3C: per-stage teacher sequences for end-to-end stage routing. Build one privileged
+        # sequence per stage id (0/1/2) using that instance's stage-specific teacher_messages.
+        # These are scored separately by the ref worker and spliced per token downstream.
+        stage_teacher_tensors = {}
+        if (
+            self._stage_routing_enabled()
+            and stage_ids_batch is not None
+            and teacher_messages_by_stage is not None
+        ):
+            # Slot ids: the union of context ids across rows. Stage mode -> {0,1,2};
+            # dynamic-frontier mode -> {0..max_epochs-1} (variable, one slot per
+            # establishment epoch). Rows lacking a slot fall back inside
+            # _teacher_seq_from_messages to the plain student prompt, and their
+            # per-token ids never select those slots.
+            sid_union = sorted({
+                sid for row in teacher_messages_by_stage if isinstance(row, dict) for sid in row
+            }) or [0, 1, 2]
+            for sid in sid_union:
+                msgs_for_stage = [
+                    (row.get(sid) if isinstance(row, dict) else None)
+                    for row in teacher_messages_by_stage
+                ]
+                s_inp, s_att, s_pos, _ = _teacher_seq_from_messages(msgs_for_stage)
+                stage_teacher_tensors[f"opsd_teacher_input_ids_stage{sid}"] = s_inp
+                stage_teacher_tensors[f"opsd_teacher_attention_mask_stage{sid}"] = s_att
+                stage_teacher_tensors[f"opsd_teacher_position_ids_stage{sid}"] = s_pos
+
+        opsd_loss_mask = traj_mask.detach().clone().float()
+        for i in range(opsd_loss_mask.shape[0]):
+            valid_len = int(valid_response_lengths[i].item())
+            if valid_len < max_response_length:
+                opsd_loss_mask[i, valid_len:] = 0
+            if max_tokens_per_sample > 0:
+                opsd_loss_mask[i, max_tokens_per_sample:] = 0
+        active_tokens_per_sample = opsd_loss_mask.sum(dim=1)
+        valid_tokens_per_sample = valid_response_lengths.to(dtype=opsd_loss_mask.dtype, device=opsd_loss_mask.device)
+        env_tokens_masked = (valid_tokens_per_sample - active_tokens_per_sample).clamp_min(0)
+        active_prefix_tokens_per_sample = torch.tensor(
+            [self._response_mask_active_prefix_len(opsd_loss_mask[i]) for i in range(opsd_loss_mask.shape[0])],
+            dtype=opsd_loss_mask.dtype,
+            device=opsd_loss_mask.device,
+        )
+        active_prefix_env_tokens = (active_prefix_tokens_per_sample - active_tokens_per_sample).clamp_min(0)
+
+        opsd_tensors = {
+            "opsd_teacher_input_ids": teacher_input_ids,
+            "opsd_teacher_attention_mask": teacher_attention_mask,
+            "opsd_teacher_position_ids": teacher_position_ids,
+            "opsd_loss_mask": opsd_loss_mask,
+        }
+        opsd_tensors.update(stage_teacher_tensors)
+        return opsd_tensors, {
+            "opsd_teacher/source_is_ref_policy": float(self._is_ref_policy_teacher_source(source)),
+            "opsd_teacher/stage_routing_variants": float(len(stage_teacher_tensors) // 3),
+            "opsd_teacher/source_is_actor": float(self._is_actor_teacher_source(source)),
+            "opsd_teacher/privileged_context_samples": float(privileged_context_samples),
+            "opsd_teacher/max_tokens_per_sample": float(max_tokens_per_sample),
+            "opsd/loss_mask_tokens": float(opsd_loss_mask.sum().item()),
+            "opsd/model_tokens": float(active_tokens_per_sample.sum().item()),
+            "opsd/env_tokens_masked": float(env_tokens_masked.sum().item()),
+            "opsd/max_active_tokens_per_sample": float(active_tokens_per_sample.max().item())
+            if active_tokens_per_sample.numel()
+            else 0.0,
+            "opsd/max_active_response_prefix_tokens_per_sample": float(active_prefix_tokens_per_sample.max().item())
+            if active_prefix_tokens_per_sample.numel()
+            else 0.0,
+            "opsd/active_prefix_env_tokens": float(active_prefix_env_tokens.sum().item()),
+        }
+
+    def _build_opsd_teacher_topk_tensors(
+        self,
+        *,
+        prompts_batch: torch.Tensor,
+        response_batch: torch.Tensor,
+        traj_mask: torch.Tensor,
+        valid_response_lengths: torch.Tensor,
+        teacher_messages_batch: list[list[dict[str, str]] | None] | None = None,
+    ) -> tuple[dict[str, torch.Tensor], dict[str, float]]:
+        """Optionally score response tokens with an external teacher top-k service."""
+
+        if not self._opsd_enabled():
+            return {}, {}
+
+        opd_cfg = self._opsd_config()
+        actor_cfg = self.config.actor_rollout_ref.actor
+        teacher_source = self._opsd_teacher_source()
+        if self._is_ref_policy_teacher_source(teacher_source):
+            return {}, {}
+        fail_open = bool(self._cfg_get(opd_cfg, "fail_open", True))
+
+        if teacher_source == "rollout":
+            base_url = self._rollout_teacher_base_url()
+            model_name = self._rollout_teacher_model_name()
+            api_key = None
+        elif teacher_source == "external":
+            base_url = (
+                self._cfg_get(opd_cfg, "teacher_base_url", None)
+                or os.environ.get("OPSD_TEACHER_BASE_URL")
+                or os.environ.get("OPENAI_BASE_URL")
+            )
+            model_name = (
+                self._cfg_get(opd_cfg, "teacher_model_name", None)
+                or os.environ.get("OPSD_TEACHER_MODEL")
+                or os.environ.get("OPENAI_MODEL")
+            )
+            api_key = self._cfg_get(opd_cfg, "teacher_api_key", os.environ.get("OPSD_TEACHER_API_KEY"))
+        else:
+            raise ValueError(f"Unsupported OPSD teacher_source: {teacher_source!r}")
+
+        if not base_url or not model_name:
+            message = (
+                f"[opsd] teacher source={teacher_source} has no usable base_url/model_name; "
+                "skip teacher top-k tensors"
+            )
+            if not fail_open:
+                raise RuntimeError(message)
+            print(message, flush=True)
+            return {}, {
+                "opsd_teacher/enabled_without_endpoint": 1.0,
+                "opsd_teacher/source_is_rollout": float(teacher_source == "rollout"),
+            }
+
+        topk_k = int(self._cfg_get(opd_cfg, "topk_k", self._cfg_get(actor_cfg, "opd_topk_k", 32)))
+        max_tokens_per_sample = int(self._cfg_get(opd_cfg, "max_tokens_per_sample", 0))
+        timeout_sec = float(self._cfg_get(opd_cfg, "teacher_timeout_sec", 120.0))
+        client = TeacherTopKClient(
+            base_url=base_url,
+            model_name=model_name,
+            api_key=api_key,
+            timeout_sec=timeout_sec,
+        )
+
+        batch_size, max_response_length = response_batch.shape
+        max_prompt_length = int(self.config.data.max_prompt_length)
+        all_token_ids = []
+        all_log_probs = []
+        all_loss_masks = []
+        scored = 0
+        failed = 0
+        privileged_context_samples = 0
+        pad_id = self.tokenizer.pad_token_id
+        for i in range(batch_size):
+            teacher_messages = (
+                teacher_messages_batch[i]
+                if teacher_messages_batch is not None and i < len(teacher_messages_batch)
+                else None
+            )
+            prompt_ids = self._messages_to_prompt_token_ids(teacher_messages)
+            if prompt_ids:
+                privileged_context_samples += 1
+            else:
+                prompt_ids = prompts_batch[i][prompts_batch[i] != pad_id].detach().cpu().tolist()
+            if len(prompt_ids) > max_prompt_length:
+                print(
+                    f"Truncating overlong OPSD teacher prompt from {len(prompt_ids)} "
+                    f"to {max_prompt_length} tokens before teacher scoring",
+                    flush=True,
+                )
+                prompt_ids = prompt_ids[-max_prompt_length:]
+            valid_len = int(valid_response_lengths[i].item())
+            response_ids = response_batch[i, :valid_len].detach().cpu().tolist()
+            train_mask = traj_mask[i].detach().cpu().float()
+            try:
+                with self._tokenizer_lock:
+                    rows = client.score_response_token_ids(
+                        tokenizer=self.tokenizer,
+                        prompt_token_ids=prompt_ids,
+                        response_token_ids=response_ids,
+                        topk_k=topk_k,
+                        max_tokens=max_tokens_per_sample,
+                    )
+                    token_ids, log_probs, loss_mask = top_logprobs_to_tensors(
+                        rows,
+                        tokenizer=self.tokenizer,
+                        max_response_length=max_response_length,
+                        topk_k=topk_k,
+                        train_mask=train_mask,
+                    )
+                scored += int(loss_mask.sum().item() > 0)
+            except Exception as exc:
+                failed += 1
+                if not fail_open:
+                    raise
+                print(f"[opsd] teacher top-k scoring failed for sample {i}: {exc}", flush=True)
+                token_ids = torch.full((max_response_length, topk_k), int(pad_id or 0), dtype=torch.long)
+                log_probs = torch.full((max_response_length, topk_k), float("-inf"), dtype=torch.float32)
+                loss_mask = torch.zeros(max_response_length, dtype=torch.float32)
+            all_token_ids.append(token_ids)
+            all_log_probs.append(log_probs)
+            all_loss_masks.append(loss_mask)
+
+        return {
+            "teacher_topk_token_ids": torch.stack(all_token_ids, dim=0),
+            "teacher_topk_log_probs": torch.stack(all_log_probs, dim=0),
+            "opsd_loss_mask": torch.stack(all_loss_masks, dim=0),
+        }, {
+            "opsd_teacher/scored_samples": float(scored),
+            "opsd_teacher/failed_samples": float(failed),
+            "opsd_teacher/topk_k": float(topk_k),
+            "opsd_teacher/max_tokens_per_sample": float(max_tokens_per_sample),
+            "opsd_teacher/source_is_rollout": float(teacher_source == "rollout"),
+            "opsd_teacher/privileged_context_samples": float(privileged_context_samples),
+            "opsd/loss_mask_tokens": float(sum(mask.sum().item() for mask in all_loss_masks)),
+            "opsd/model_tokens": float(sum(mask.sum().item() for mask in all_loss_masks)),
+            "opsd/env_tokens_masked": float(
+                sum(
+                    max(0.0, float(valid_response_lengths[i].item()) - float(all_loss_masks[i].sum().item()))
+                    for i in range(len(all_loss_masks))
+                )
+            ),
+            "opsd/max_active_tokens_per_sample": float(
+                max((mask.sum().item() for mask in all_loss_masks), default=0.0)
+            ),
+            "opsd/max_active_response_prefix_tokens_per_sample": float(
+                max((self._response_mask_active_prefix_len(mask) for mask in all_loss_masks), default=0.0)
+            ),
+            "opsd/active_prefix_env_tokens": float(
+                sum(
+                    max(0.0, self._response_mask_active_prefix_len(mask) - float(mask.sum().item()))
+                    for mask in all_loss_masks
+                )
+            ),
+        }
+
+    def _mask_opsd_tensors_for_failed_exploration(
+        self,
+        *,
+        opsd_tensors: dict[str, torch.Tensor],
+        opsd_metrics: dict[str, float],
+        opsd_eligible_mask: torch.Tensor,
+        valid_response_lengths: torch.Tensor,
+    ) -> tuple[dict[str, torch.Tensor], dict[str, float]]:
+        """Disable OPD imitation for trajectories that did not perform useful exploration."""
+
+        opsd_loss_mask = opsd_tensors.get("opsd_loss_mask")
+        if opsd_loss_mask is None:
+            return opsd_tensors, opsd_metrics
+
+        opsd_eligible_mask = opsd_eligible_mask.to(device=opsd_loss_mask.device, dtype=opsd_loss_mask.dtype)
+        if opsd_eligible_mask.ndim == 1:
+            opsd_eligible_mask = opsd_eligible_mask[:, None]
+        opsd_loss_mask.mul_(opsd_eligible_mask)
+
+        active_tokens_per_sample = opsd_loss_mask.sum(dim=1)
+        valid_tokens_per_sample = valid_response_lengths.to(
+            dtype=opsd_loss_mask.dtype,
+            device=opsd_loss_mask.device,
+        )
+        env_tokens_masked = (valid_tokens_per_sample - active_tokens_per_sample).clamp_min(0)
+        active_prefix_tokens_per_sample = torch.tensor(
+            [self._response_mask_active_prefix_len(opsd_loss_mask[i]) for i in range(opsd_loss_mask.shape[0])],
+            dtype=opsd_loss_mask.dtype,
+            device=opsd_loss_mask.device,
+        )
+        active_prefix_env_tokens = (active_prefix_tokens_per_sample - active_tokens_per_sample).clamp_min(0)
+        eligible_samples = float(opsd_eligible_mask.view(-1).sum().item())
+        total_samples = float(opsd_eligible_mask.numel())
+
+        updated_metrics = dict(opsd_metrics)
+        updated_metrics.update(
+            {
+                "opsd/exploration_eligible_samples": eligible_samples,
+                "opsd/failed_exploration_samples_masked": total_samples - eligible_samples,
+                "opsd/loss_mask_tokens": float(opsd_loss_mask.sum().item()),
+                "opsd/model_tokens": float(active_tokens_per_sample.sum().item()),
+                "opsd/env_tokens_masked": float(env_tokens_masked.sum().item()),
+                "opsd/max_active_tokens_per_sample": float(active_tokens_per_sample.max().item())
+                if active_tokens_per_sample.numel()
+                else 0.0,
+                "opsd/max_active_response_prefix_tokens_per_sample": float(active_prefix_tokens_per_sample.max().item())
+                if active_prefix_tokens_per_sample.numel()
+                else 0.0,
+                "opsd/active_prefix_env_tokens": float(active_prefix_env_tokens.sum().item()),
+            }
+        )
+        return opsd_tensors, updated_metrics
