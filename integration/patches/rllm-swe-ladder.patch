+    def _init_reward_curve_paths(self):
+        metrics_dir = os.path.join(self.config.trainer.default_local_dir, "metrics")
+        os.makedirs(metrics_dir, exist_ok=True)
+        self._reward_curve_dir = metrics_dir
+        self._reward_curve_jsonl = os.path.join(metrics_dir, "reward_curve.jsonl")
+        self._reward_curve_png = os.path.join(metrics_dir, "reward_curve.png")
+        self._train_curve_jsonl = os.path.join(metrics_dir, "train_curve.jsonl")
+        self._reward_history = []
+        self._train_history = []
+        self._matplotlib_unavailable = False
+        if os.path.exists(self._reward_curve_jsonl):
+            os.remove(self._reward_curve_jsonl)
+        if os.path.exists(self._train_curve_jsonl):
+            os.remove(self._train_curve_jsonl)
+
+    @staticmethod
+    def _metric_to_json_scalar(value):
+        if isinstance(value, torch.Tensor):
+            if value.numel() != 1:
+                return None
+            value = value.detach().float().cpu().item()
+        if isinstance(value, np.generic):
+            value = value.item()
+        if isinstance(value, bool):
+            return float(value)
+        if isinstance(value, (int, float)):
+            value = float(value)
+            return value if math.isfinite(value) else None
+        return None
+
+    def _save_reward_curve_plot(self):
+        if self._matplotlib_unavailable or not self._reward_history or self._reward_curve_png is None:
+            return
+        try:
+            import matplotlib
+
+            matplotlib.use("Agg")
+            import matplotlib.pyplot as plt
+        except Exception as exc:
+            self._matplotlib_unavailable = True
+            print(f"[train] matplotlib unavailable, skip reward curve png: {exc}", flush=True)
+            return
+
+        steps = [point["global_step"] for point in self._reward_history]
+        rewards = [point["reward_mean"] for point in self._reward_history]
+
+        fig = plt.figure(figsize=(8.8, 4.8))
+        plt.plot(steps, rewards, color="#1f77b4", linewidth=1.8, marker="o", markersize=3.2)
+        plt.xlabel("Global Step")
+        plt.ylabel("Reward Mean")
+        plt.title("Training Reward Curve")
+        plt.grid(alpha=0.25, linestyle="--")
+        fig.tight_layout()
+        fig.savefig(self._reward_curve_png, dpi=160)
+        plt.close(fig)
+
+    def _append_reward_point(self, reward_mean: float | None, epoch_idx: int, batch_idx: int, total_batches_per_epoch: int):
+        if reward_mean is None:
+            return
+        if self._reward_curve_jsonl is None:
+            self._init_reward_curve_paths()
+        point = {
+            "global_step": int(self.global_steps),
+            "epoch": int(epoch_idx + 1),
+            "batch": int(batch_idx),
+            "batches_per_epoch": int(total_batches_per_epoch),
+            "reward_mean": float(reward_mean),
+        }
+        self._reward_history.append(point)
+        with open(self._reward_curve_jsonl, "a", encoding="utf-8") as f:
+            f.write(json.dumps(point, ensure_ascii=False) + "\n")
+
+        plot_freq = int(self.config.trainer.get("reward_curve_plot_freq", 1))
+        if plot_freq <= 0:
+            plot_freq = 1
+        if len(self._reward_history) % plot_freq == 0:
+            self._save_reward_curve_plot()
+
+    def _append_train_curve_point(
+        self,
+        *,
+        metrics: dict,
+        reward_mean: float | None,
+        epoch_idx: int,
+        batch_idx: int,
+        total_batches_per_epoch: int,
+    ):
+        if self._train_curve_jsonl is None:
+            self._init_reward_curve_paths()
+        point = {
+            "global_step": int(self.global_steps),
+            "epoch": int(epoch_idx + 1),
+            "batch": int(batch_idx),
+            "batches_per_epoch": int(total_batches_per_epoch),
+        }
+        if reward_mean is not None:
+            point["reward_mean"] = float(reward_mean)
+        primary_metric_keys = (
+            "actor/policy_loss_total",
+            "actor/pg_loss",
+            "actor/opsd_policy_loss",
+            "actor/opsd_reverse_kl_loss",
+            "opsd/as_policy_loss_enabled",
+            "opsd/reverse_kl_mean",
+            "opsd/active_tokens",
+            "opsd/loss_mask_tokens",
+            "opsd/teacher_topk_mass",
+            "opsd/skipped_old_log_prob",
+            "opsd_teacher/topk_k",
+            "opsd_teacher/source_is_ref_policy",
+            "opsd_teacher/privileged_context_samples",
+            "response_length/mean",
+            "response_length/max",
+            "response_length/clip_ratio",
+        )
+        for key in primary_metric_keys:
+            if key not in metrics:
+                continue
+            scalar = self._metric_to_json_scalar(metrics[key])
+            if scalar is not None:
+                point[key] = scalar
+        for key, value in sorted(metrics.items()):
+            if key in point:
+                continue
+            scalar = self._metric_to_json_scalar(value)
+            if scalar is not None:
+                point[key] = scalar
+        self._train_history.append(point)
+        with open(self._train_curve_jsonl, "a", encoding="utf-8") as f:
+            f.write(json.dumps(point, ensure_ascii=False) + "\n")
+
+    def _update_train_progress(
+        self,
+        progress_bar,
+        *,
+        epoch_idx: int,
+        batch_idx: int,
+        total_batches_per_epoch: int,
+        reward_mean: float | None,
+        status: str = "running",
+    ):
+        if progress_bar is None:
+            return
+        postfix = {
+            "epoch": f"{epoch_idx + 1}/{self.config.trainer.total_epochs}",
+            "batch": f"{batch_idx}/{total_batches_per_epoch}",
+            "status": status,
+        }
+        postfix["reward"] = f"{reward_mean:.3f}" if reward_mean is not None else "na"
+        progress_bar.set_postfix(postfix)
+        progress_bar.update(1)
+
+    def _stage_global_step_offset(self) -> int:
+        """Absolute global step before the current stage starts."""
+        raw_offset = self.config.trainer.get("stage_global_step_offset", 0)
+        if raw_offset is None:
+            return 0
+        try:
+            offset = int(raw_offset)
+        except (TypeError, ValueError) as exc:
+            raise ValueError(f"trainer.stage_global_step_offset must be an integer, got {raw_offset!r}") from exc
+        if offset < 0:
+            raise ValueError(f"trainer.stage_global_step_offset must be non-negative, got {offset}")
+        return offset
+
+    def _effective_total_training_steps(self) -> int:
+        return self._stage_global_step_offset() + int(self.total_training_steps)
+
+    def _stage_completed_steps_before_current(self) -> int:
+        # self.global_steps is the step about to run after the resume increment.
+        completed = int(getattr(self, "global_steps", 0)) - self._stage_global_step_offset() - 1
+        return max(0, min(completed, int(self.total_training_steps)))
+
+    def _opsd_ref_teacher_loads_resume_checkpoint(self) -> bool:
+        opd_cfg = self._opsd_config()
+        return flag_enabled(self._cfg_get(opd_cfg, "ref_load_checkpoint_from_resume", False))
+
+    def _resume_path_checkpoint_folder(self) -> str | None:
+        trainer_cfg = self.config.trainer
+        if trainer_cfg.get("resume_mode", "disable") != "resume_path":
+            return None
+        resume_from_path = trainer_cfg.get("resume_from_path", None)
+        if resume_from_path is None or str(resume_from_path).lower() == "null":
+            return None
+        checkpoint_folder = str(resume_from_path)
+        if not os.path.isabs(checkpoint_folder):
+            checkpoint_folder = os.path.join(os.getcwd(), checkpoint_folder)
+        return checkpoint_folder
+
+    def _load_opsd_ref_teacher_checkpoint_from_resume(self):
+        if not (
+            self._opsd_enabled()
+            and self._opsd_kl_enabled()
+            and self._is_ref_policy_teacher_source(self._opsd_teacher_source())
+            and self._opsd_ref_teacher_loads_resume_checkpoint()
+        ):
+            return
+        if not self.use_reference_policy or not hasattr(self, "ref_policy_wg"):
+            raise RuntimeError("OPSD ref-policy teacher checkpoint loading requires reference policy workers")
+
+        checkpoint_folder = self._resume_path_checkpoint_folder()
+        if checkpoint_folder is None:
+            raise RuntimeError(
+                "opd.ref_load_checkpoint_from_resume=True requires trainer.resume_mode=resume_path "
+                "and a valid trainer.resume_from_path"
+            )
+        actor_path = os.path.join(checkpoint_folder, "actor")
+        if not os.path.isdir(actor_path):
+            raise FileNotFoundError(f"OPSD ref-policy teacher checkpoint actor folder not found: {actor_path}")
+
+        print(f"[opsd] Loading ref-policy teacher model weights from resumed actor checkpoint: {actor_path}", flush=True)
+        self.ref_policy_wg.load_ref_checkpoint(actor_path, del_local_after_load=False)
+
+    def _load_checkpoint(self):
+        result = super()._load_checkpoint()
+        self._load_opsd_ref_teacher_checkpoint_from_resume()
+        return result
