+    def _dump_incremental_trajectory(self, trajectory: dict):
+        try:
+            save_dir, step_fn, readable_fn, trajectory_readable = self._trajectory_dump_paths()
+            os.makedirs(save_dir, exist_ok=True)
+            with self._get_trajectory_dump_lock():
+                if getattr(self, "_incremental_trajectory_dump_step", None) != self.global_steps:
+                    self._incremental_trajectory_dump_records = []
+                    self._incremental_trajectory_dump_step = self.global_steps
+
+                record = self._record_from_completed_trajectory(trajectory)
+                self._incremental_trajectory_dump_records.append(record)
+                with open(step_fn, "a", encoding="utf-8") as f:
+                    f.write(json.dumps(self._trajectory_jsonl_record(record), ensure_ascii=False) + "\n")
+                    f.flush()
+                    os.fsync(f.fileno())
+
+                if trajectory_readable:
+                    readable_records = [
+                        self._format_trajectory_readable(r)
+                        for r in self._incremental_trajectory_dump_records
+                    ]
+                    tmp_readable_fn = f"{readable_fn}.tmp"
+                    with open(tmp_readable_fn, "w", encoding="utf-8") as f:
+                        json.dump(readable_records, f, ensure_ascii=False, indent=2)
+                        f.flush()
+                        os.fsync(f.fileno())
+                    os.replace(tmp_readable_fn, readable_fn)
+
+                print(
