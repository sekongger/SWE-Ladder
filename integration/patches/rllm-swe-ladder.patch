+    def _checkpoint_weight_transfer_bytes_per_param(self) -> int:
+        dtype_name = self.config.actor_rollout_ref.rollout.checkpoint_engine.get("weight_transfer_dtype", "bf16")
+        dtype_name = str(dtype_name).lower()
+        if dtype_name in {"bf16", "bfloat16", "fp16", "float16"}:
+            return 2
+        return 4
