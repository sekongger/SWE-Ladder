+        with open_dict(checkpoint_engine_cfg):
+            if backend == "naive":
+                checkpoint_engine_cfg.backend = get_nccl_backend()
+            requested_bucket_mb = int(checkpoint_engine_cfg.get("update_weights_bucket_megabytes", 2048))
+            model_min_bucket_mb = self._infer_min_checkpoint_bucket_mb()
+            min_bucket_mb = max(32, model_min_bucket_mb, _env_int("PIPELINE_CHECKPOINT_ENGINE_MIN_BUCKET_MB", model_min_bucket_mb))
+            max_bucket_mb = max(min_bucket_mb, _env_int("PIPELINE_CHECKPOINT_ENGINE_MAX_BUCKET_MB", 1024))
+
+            tuned_bucket_mb = requested_bucket_mb
+            reason = None
+            if requested_bucket_mb < min_bucket_mb:
+                tuned_bucket_mb = min_bucket_mb
+                reason = "too small"
+            elif requested_bucket_mb > max_bucket_mb:
+                tuned_bucket_mb = max_bucket_mb
+                reason = "too large"
+            if reason is not None:
+                checkpoint_engine_cfg.update_weights_bucket_megabytes = tuned_bucket_mb
+        print(
+            "[pipeline:init] split actor/rollout requires checkpoint-engine weight sync; "
+            f"auto-set backend={checkpoint_engine_cfg.backend}, "
+            f"bucket_mb={checkpoint_engine_cfg.update_weights_bucket_megabytes}, "
+            f"requested_bucket_mb={requested_bucket_mb}, "
+            f"min_bucket_mb={min_bucket_mb}, max_bucket_mb={max_bucket_mb}, "
+            f"reason={reason or 'unchanged'}",
